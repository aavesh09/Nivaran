---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout pageTitle="Submit Problem">
  <section class="py-32 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sage-100 border-2 border-sage-300 text-sage-800 font-bold text-sm mb-6">
          👥 Citizen Portal
        </div>
        <h1 class="font-display text-4xl lg:text-5xl font-bold text-navy-900 mb-4">
          Submit a Problem
        </h1>
        <p class="text-xl text-navy-600">
          Help us identify challenges that need innovative solutions
        </p>
      </div>

      <!-- Form -->
      <form class="glass p-8 lg:p-10 space-y-6 border-2 border-navy-200">
        <!-- Your Name -->
        <div>
          <label for="name" class="block text-sm font-bold text-navy-900 mb-2">Your Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
            placeholder="John Doe"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-bold text-navy-900 mb-2">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
            placeholder="john@example.com"
          />
        </div>

        <!-- Problem Title -->
        <div>
          <label for="title" class="block text-sm font-bold text-navy-900 mb-2">Problem Title</label>
          <input
            type="text"
            id="title"
            name="title"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
            placeholder="Brief description of the problem"
          />
        </div>

        <!-- Category -->
        <div>
          <label for="category" class="block text-sm font-bold text-navy-900 mb-2">Category</label>
          <select
            id="category"
            name="category"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
          >
            <option value="">Select a category</option>
            <option value="transportation">🚗 Transportation</option>
            <option value="environment">🌿 Environment</option>
            <option value="healthcare">🏥 Healthcare</option>
            <option value="education">📚 Education</option>
            <option value="safety">🛡️ Public Safety</option>
            <option value="infrastructure">🏗️ Infrastructure</option>
            <option value="digital">💻 Digital Services</option>
            <option value="other">📋 Other</option>
          </select>
        </div>

        <!-- Problem Description -->
        <div>
          <label for="description" class="block text-sm font-bold text-navy-900 mb-2">Problem Description</label>
          <textarea
            id="description"
            name="description"
            required
            rows="6"
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all resize-none"
            placeholder="Describe the problem in detail..."
          ></textarea>
        </div>

        <!-- Impact -->
        <div>
          <label for="impact" class="block text-sm font-bold text-navy-900 mb-2">Who is affected?</label>
          <textarea
            id="impact"
            name="impact"
            rows="3"
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all resize-none"
            placeholder="Describe who experiences this problem and how it affects them"
          ></textarea>
        </div>

        <!-- Location -->
        <div>
          <label for="location" class="block text-sm font-bold text-navy-900 mb-2">Location (Optional)</label>
          <input
            type="text"
            id="location"
            name="location"
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
            placeholder="City, State"
          />
        </div>

        <!-- Privacy Notice -->
        <div class="bg-sage-50 border-2 border-sage-200 rounded-lg p-4">
          <p class="text-sm text-navy-700 font-medium">
            <span class="font-bold">Privacy Notice:</span> Your submission will be reviewed by government officials and may be shared with potential solution providers. Your contact information will be kept confidential.
          </p>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full px-8 py-4 rounded-lg bg-gradient-to-r from-sage-500 to-sage-600 text-white font-bold text-lg hover:from-sage-600 hover:to-sage-700 transition-all shadow-lg hover:shadow-xl hover:scale-[1.02] flex items-center justify-center gap-2"
        >
          <span>Submit Problem</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>
      </form>

      <!-- What Happens Next -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-sage-100 text-sage-700 text-2xl flex items-center justify-center mx-auto mb-4 font-bold">1</div>
          <h3 class="font-bold text-navy-900 mb-2">Review</h3>
          <p class="text-sm text-navy-600">Your submission is reviewed by our team</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-sage-100 text-sage-700 text-2xl flex items-center justify-center mx-auto mb-4 font-bold">2</div>
          <h3 class="font-bold text-navy-900 mb-2">Match</h3>
          <p class="text-sm text-navy-600">We connect it with potential solutions</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-sage-100 text-sage-700 text-2xl flex items-center justify-center mx-auto mb-4 font-bold">3</div>
          <h3 class="font-bold text-navy-900 mb-2">Update</h3>
          <p class="text-sm text-navy-600">You'll receive updates on progress</p>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<script>
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you for your submission! Our team will review it shortly.');
      form.reset();
    });
  }
</script>
