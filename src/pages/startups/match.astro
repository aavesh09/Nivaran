---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';

import problems from '../../data/problems.json';
import startups from '../../data/startups.json';

const breadcrumbs = [
  { label: 'Dashboard', href: '/' },
  { label: 'Startups', href: '/startups' },
  { label: 'Match' },
];

const openProblems = problems.filter(p => p.status === 'open' || p.status === 'matched');

const domainIcons: Record<string, string> = {
  traffic: '🚦', waste: '♻️', water: '💧', safety: '🛡️',
  energy: '⚡', digital: '💻', environment: '🌿',
};
---

<Layout pageTitle="Startup Matching" breadcrumbs={breadcrumbs}>
  <div class="mb-8 animate-fade-in">
    <h1 class="font-display text-3xl font-bold text-text-primary">
      Startup <span class="gradient-text">Matching</span>
    </h1>
    <p class="text-text-secondary mt-2">Select a problem to find the best-matched startups using our rule-based scoring engine.</p>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <!-- Problem selection -->
    <div class="space-y-4">
      <h2 class="font-display text-lg font-bold text-text-primary">Select a Problem</h2>
      <div class="space-y-2" id="problem-list">
        {openProblems.map(problem => (
          <button
            class="problem-select w-full text-left glass-sm glass-hover p-4 space-y-2 transition-all cursor-pointer"
            data-problem={JSON.stringify(problem)}
          >
            <div class="flex items-center gap-2">
              <span class="text-lg">{domainIcons[problem.domain] || '📋'}</span>
              <h3 class="font-medium text-text-primary text-sm line-clamp-1">{problem.title}</h3>
            </div>
            <div class="flex items-center gap-2">
              <Badge variant="accent" size="sm">{problem.domain}</Badge>
              <span class="text-xs text-text-muted">${(problem.budget / 1000).toFixed(0)}K</span>
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Match results -->
    <div class="xl:col-span-2">
      <div id="match-placeholder" class="glass p-12 text-center space-y-4 animate-fade-in">
        <div class="text-5xl">🔍</div>
        <h3 class="font-display text-lg font-bold text-text-primary">Select a Problem</h3>
        <p class="text-sm text-text-secondary">Choose a problem from the left panel to see matched startups ranked by compatibility score.</p>
      </div>

      <div id="match-results" class="hidden space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-display text-lg font-bold text-text-primary">Match Results</h2>
          <div id="match-info" class="text-sm text-text-secondary"></div>
        </div>

        <!-- Scoring explanation -->
        <div class="glass-sm p-4 flex items-center gap-6 text-xs text-text-muted">
          <span class="font-medium text-text-secondary">Score Weights:</span>
          <span>🎯 Domain 50%</span>
          <span>📈 Stage 30%</span>
          <span>👥 Team 20%</span>
        </div>

        <div id="match-list" class="space-y-3"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { matchStartups, getMatchLabel } from '../../scripts/matching.js';
  import startupsData from '../../data/startups.json';

  const placeholder = document.getElementById('match-placeholder');
  const results = document.getElementById('match-results');
  const matchList = document.getElementById('match-list');
  const matchInfo = document.getElementById('match-info');

  const domainIcons: Record<string, string> = {
    traffic: '🚦', waste: '♻️', water: '💧', safety: '🛡️',
    energy: '⚡', digital: '💻', environment: '🌿',
  };

  document.querySelectorAll('.problem-select').forEach(btn => {
    btn.addEventListener('click', () => {
      // Highlight selected
      document.querySelectorAll('.problem-select').forEach(b => {
        b.classList.remove('border-teal-500/50', 'bg-teal-500/5');
      });
      btn.classList.add('border-teal-500/50', 'bg-teal-500/5');

      const problem = JSON.parse((btn as HTMLElement).dataset.problem || '{}');
      const matched = matchStartups(problem, startupsData);

      if (placeholder) placeholder.classList.add('hidden');
      if (results) results.classList.remove('hidden');
      if (matchInfo) matchInfo.textContent = `${matched.length} startups scored for "${problem.title}"`;

      if (matchList) {
        matchList.innerHTML = matched.map((s: any, i: number) => {
          const { label, color } = getMatchLabel(s.matchScore);
          const initials = s.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
          const scoreColor = s.matchScore >= 80 ? '#22c55e' : s.matchScore >= 60 ? '#3b82f6' : s.matchScore >= 40 ? '#f59e0b' : '#ef4444';
          const badgeClass = s.matchScore >= 80 ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/20' :
                             s.matchScore >= 60 ? 'bg-blue-500/15 text-blue-400 border-blue-500/20' :
                             s.matchScore >= 40 ? 'bg-amber-500/15 text-amber-400 border-amber-500/20' :
                             'bg-red-500/15 text-red-400 border-red-500/20';

          return `
            <div class="glass glass-hover p-5 space-y-3 animate-slide-up" style="animation-delay: ${i * 80}ms;">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-teal-500/20 to-blue-500/20 border border-white/10 flex items-center justify-center font-bold text-sm text-teal-400 shrink-0">
                    ${initials}
                  </div>
                  <div>
                    <h3 class="font-bold text-[var(--color-text-primary)]">${s.name}</h3>
                    <p class="text-xs text-[var(--color-text-muted)]">${s.location} · ${s.teamSize} people · ${s.stage}</p>
                  </div>
                </div>
                <div class="flex flex-col items-center shrink-0">
                  <div class="text-2xl font-bold font-[var(--font-display)]" style="color: ${scoreColor}">${s.matchScore}%</div>
                  <span class="inline-flex items-center font-medium rounded-full border text-xs px-2.5 py-0.5 ${badgeClass}">${label}</span>
                </div>
              </div>
              <p class="text-sm text-[var(--color-text-secondary)]">${s.description}</p>
              <div class="flex items-center gap-4 text-xs text-[var(--color-text-muted)]">
                <span>🎯 Domain: ${s.matchBreakdown.domain}%</span>
                <span>📈 Stage: ${s.matchBreakdown.stage}%</span>
                <span>👥 Team: ${s.matchBreakdown.team}%</span>
              </div>
              <div class="flex items-center gap-2 pt-2 border-t border-white/[0.06]">
                <a href="/pilots/new?problem=${problem.id}&startup=${s.id}" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-gradient-to-r from-teal-500 to-blue-500 text-white text-xs font-medium transition-all hover:shadow-lg hover:shadow-teal-500/25">
                  🚀 Create Pilot
                </a>
                <span class="text-xs text-[var(--color-text-muted)] flex items-center gap-1">
                  ${s.domains.map((d: string) => `${domainIcons[d] || '📋'} ${d}`).join(' · ')}
                </span>
              </div>
            </div>
          `;
        }).join('');
      }
    });
  });
</script>
