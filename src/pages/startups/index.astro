---
import Layout from '../../layouts/Layout.astro';
import StartupCard from '../../components/StartupCard.astro';
import Badge from '../../components/Badge.astro';

import startups from '../../data/startups.json';

const breadcrumbs = [
  { label: 'Dashboard', href: '/' },
  { label: 'Startups' },
];

// Get unique domains
const allDomains = [...new Set(startups.flatMap(s => s.domains))].sort();
---

<Layout pageTitle="Startups" breadcrumbs={breadcrumbs}>
  <div class="flex items-center justify-between mb-8 animate-fade-in">
    <div>
      <h1 class="font-display text-3xl font-bold text-text-primary">Startup Directory</h1>
      <p class="text-text-secondary mt-1">{startups.length} registered startups ready for government pilots</p>
    </div>
    <a
      href="/startups/match"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-teal-500 to-blue-500 text-white font-medium text-sm transition-all hover:shadow-lg hover:shadow-teal-500/25 hover:-translate-y-0.5"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      Match to Problem
    </a>
  </div>

  <!-- Domain filter -->
  <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2 animate-slide-up opacity-0" style="animation-fill-mode: forwards;">
    <button class="domain-tab active px-4 py-2 rounded-xl text-sm font-medium transition-all bg-teal-500/15 text-teal-400 border border-teal-500/20" data-domain="all">
      All
    </button>
    {allDomains.map(domain => (
      <button class="domain-tab px-4 py-2 rounded-xl text-sm font-medium transition-all text-text-secondary hover:text-text-primary hover:bg-white/[0.04] border border-transparent capitalize" data-domain={domain}>
        {domain}
      </button>
    ))}
  </div>

  <!-- Startups grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" id="startups-grid">
    {startups.map((startup, i) => (
      <div
        class="startup-item animate-slide-up opacity-0"
        data-domains={startup.domains.join(',')}
        style={`animation-delay: ${i * 60}ms; animation-fill-mode: forwards;`}
      >
        <StartupCard {...startup} />
      </div>
    ))}
  </div>
</Layout>

<script>
  document.querySelectorAll('.domain-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const domain = (tab as HTMLElement).dataset.domain;

      document.querySelectorAll('.domain-tab').forEach(t => {
        t.classList.remove('active', 'bg-teal-500/15', 'text-teal-400', 'border-teal-500/20');
        t.classList.add('text-text-secondary', 'border-transparent');
      });
      tab.classList.add('active', 'bg-teal-500/15', 'text-teal-400', 'border-teal-500/20');
      tab.classList.remove('text-text-secondary', 'border-transparent');

      document.querySelectorAll('.startup-item').forEach(item => {
        const el = item as HTMLElement;
        const domains = el.dataset.domains?.split(',') || [];
        if (domain === 'all' || domains.includes(domain!)) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
