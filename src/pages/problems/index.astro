---
import Layout from '../../layouts/Layout.astro';
import ProblemCard from '../../components/ProblemCard.astro';
import Badge from '../../components/Badge.astro';

import problems from '../../data/problems.json';

const breadcrumbs = [
  { label: 'Dashboard', href: '/' },
  { label: 'Problems' },
];

// Group by status
const statusOrder = ['open', 'matched', 'pilot-active', 'pilot-completed'];
const statusLabels: Record<string, string> = {
  open: 'Open',
  matched: 'Matched',
  'pilot-active': 'Pilot Active',
  'pilot-completed': 'Completed',
};
---

<Layout pageTitle="Problems" breadcrumbs={breadcrumbs}>
  <div class="flex items-center justify-between mb-8 animate-fade-in">
    <div>
      <h1 class="font-display text-3xl font-bold text-text-primary">Government Problems</h1>
      <p class="text-text-secondary mt-1">{problems.length} submitted problems across all departments</p>
    </div>
    <a
      href="/problems/new"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-teal-500 to-blue-500 text-white font-medium text-sm transition-all hover:shadow-lg hover:shadow-teal-500/25 hover:-translate-y-0.5 active:translate-y-0"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Submit Problem
    </a>
  </div>

  <!-- Status filter tabs -->
  <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2 animate-slide-up opacity-0" style="animation-fill-mode: forwards;">
    <button class="filter-tab active px-4 py-2 rounded-xl text-sm font-medium transition-all bg-teal-500/15 text-teal-400 border border-teal-500/20" data-filter="all">
      All <span class="ml-1 text-xs opacity-70">({problems.length})</span>
    </button>
    {statusOrder.map(status => {
      const count = problems.filter(p => p.status === status).length;
      return count > 0 ? (
        <button class="filter-tab px-4 py-2 rounded-xl text-sm font-medium transition-all text-text-secondary hover:text-text-primary hover:bg-white/[0.04] border border-transparent" data-filter={status}>
          {statusLabels[status]} <span class="ml-1 text-xs opacity-70">({count})</span>
        </button>
      ) : null;
    })}
  </div>

  <!-- Problems grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="problems-grid">
    {problems.map((problem, i) => (
      <div
        class="problem-item animate-slide-up opacity-0"
        data-status={problem.status}
        style={`animation-delay: ${i * 80}ms; animation-fill-mode: forwards;`}
      >
        <ProblemCard {...problem} />
      </div>
    ))}
  </div>
</Layout>

<script>
  // Client-side filtering
  document.querySelectorAll('.filter-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = (tab as HTMLElement).dataset.filter;

      // Update active tab
      document.querySelectorAll('.filter-tab').forEach(t => {
        t.classList.remove('active', 'bg-teal-500/15', 'text-teal-400', 'border-teal-500/20');
        t.classList.add('text-text-secondary', 'border-transparent');
      });
      tab.classList.add('active', 'bg-teal-500/15', 'text-teal-400', 'border-teal-500/20');
      tab.classList.remove('text-text-secondary', 'border-transparent');

      // Filter items
      document.querySelectorAll('.problem-item').forEach(item => {
        const el = item as HTMLElement;
        if (filter === 'all' || el.dataset.status === filter) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
