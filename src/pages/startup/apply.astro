---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout pageTitle="Startup Application">
  <section class="py-32 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-navy-100 border-2 border-navy-300 text-navy-800 font-bold text-sm mb-6">
          🚀 Startup Portal
        </div>
        <h1 class="font-display text-4xl lg:text-5xl font-bold text-navy-900 mb-4">
          Apply as a Solution Provider
        </h1>
        <p class="text-xl text-navy-600">
          Join our network of innovative startups solving government challenges
        </p>
      </div>

      <!-- Form -->
      <form class="glass p-8 lg:p-10 space-y-6 border-2 border-navy-200">
        <!-- Company Name -->
        <div>
          <label for="company" class="block text-sm font-bold text-navy-900 mb-2">Company Name *</label>
          <input
            type="text"
            id="company"
            name="company"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
            placeholder="Your startup name"
          />
        </div>

        <!-- Contact Person -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="firstName" class="block text-sm font-bold text-navy-900 mb-2">First Name *</label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              required
              class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
              placeholder="John"
            />
          </div>
          <div>
            <label for="lastName" class="block text-sm font-bold text-navy-900 mb-2">Last Name *</label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              required
              class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
              placeholder="Doe"
            />
          </div>
        </div>

        <!-- Email & Phone -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="email" class="block text-sm font-bold text-navy-900 mb-2">Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
              placeholder="john@startup.com"
            />
          </div>
          <div>
            <label for="phone" class="block text-sm font-bold text-navy-900 mb-2">Phone *</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
              placeholder="+1 (555) 000-0000"
            />
          </div>
        </div>

        <!-- Website -->
        <div>
          <label for="website" class="block text-sm font-bold text-navy-900 mb-2">Website</label>
          <input
            type="url"
            id="website"
            name="website"
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
            placeholder="https://yourstartup.com"
          />
        </div>

        <!-- Industry -->
        <div>
          <label for="industry" class="block text-sm font-bold text-navy-900 mb-2">Primary Industry *</label>
          <select
            id="industry"
            name="industry"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
          >
            <option value="">Select your industry</option>
            <option value="transportation">🚗 Transportation & Mobility</option>
            <option value="environment">🌿 Environment & Sustainability</option>
            <option value="healthcare">🏥 Healthcare & Wellness</option>
            <option value="education">📚 Education Technology</option>
            <option value="safety">🛡️ Public Safety & Security</option>
            <option value="infrastructure">🏗️ Infrastructure & Construction</option>
            <option value="digital">💻 Digital Services & IT</option>
            <option value="ai">🤖 AI & Machine Learning</option>
            <option value="iot">📡 IoT & Sensors</option>
            <option value="data">📊 Data Analytics</option>
            <option value="other">📋 Other</option>
          </select>
        </div>

        <!-- Company Description -->
        <div>
          <label for="description" class="block text-sm font-bold text-navy-900 mb-2">Company Description *</label>
          <textarea
            id="description"
            name="description"
            required
            rows="5"
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all resize-none"
            placeholder="Tell us about your company, product, and what problems you solve..."
          ></textarea>
        </div>

        <!-- Solution Offering -->
        <div>
          <label for="solution" class="block text-sm font-bold text-navy-900 mb-2">What Solutions Do You Offer? *</label>
          <textarea
            id="solution"
            name="solution"
            required
            rows="4"
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all resize-none"
            placeholder="Describe your product/service and how it solves problems..."
          ></textarea>
        </div>

        <!-- Stage -->
        <div>
          <label for="stage" class="block text-sm font-bold text-navy-900 mb-2">Company Stage *</label>
          <select
            id="stage"
            name="stage"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-900 font-medium focus:border-sage-500 focus:ring-2 focus:ring-sage-500/20 outline-none transition-all"
          >
            <option value="">Select stage</option>
            <option value="idea">💡 Idea Stage</option>
            <option value="mvp">🔨 MVP/Prototype</option>
            <option value="early">🌱 Early Stage (Pre-Series A)</option>
            <option value="growth">📈 Growth Stage (Series A+)</option>
            <option value="mature">🏢 Mature/Established</option>
          </select>
        </div>

        <!-- Previous Experience -->
        <div>
          <label class="block text-sm font-bold text-navy-900 mb-3">Government Experience</label>
          <div class="space-y-2">
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="govExp" value="contracts" class="w-5 h-5 rounded border-2 border-navy-300 text-sage-600 focus:ring-sage-500" />
              <span class="text-navy-700 font-medium">Previous government contracts</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="govExp" value="pilots" class="w-5 h-5 rounded border-2 border-navy-300 text-sage-600 focus:ring-sage-500" />
              <span class="text-navy-700 font-medium">Completed pilot programs</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="govExp" value="certifications" class="w-5 h-5 rounded border-2 border-navy-300 text-sage-600 focus:ring-sage-500" />
              <span class="text-navy-700 font-medium">Government certifications</span>
            </label>
          </div>
        </div>

        <!-- Info Box -->
        <div class="bg-navy-50 border-2 border-navy-200 rounded-lg p-4">
          <p class="text-sm text-navy-700 font-medium">
            <span class="font-bold">Next Steps:</span> After submission, our team will review your application and reach out within 5-7 business days. Qualified startups will be matched with relevant government challenges.
          </p>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full px-8 py-4 rounded-lg bg-gradient-to-r from-navy-700 to-navy-800 text-white font-bold text-lg hover:from-navy-800 hover:to-navy-900 transition-all shadow-lg hover:shadow-xl hover:scale-[1.02] flex items-center justify-center gap-2"
        >
          <span>Submit Application</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12" />
          </svg>
        </button>
      </form>

      <!-- Benefits -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-navy-100 text-navy-700 text-2xl flex items-center justify-center mx-auto mb-4">💼</div>
          <h3 class="font-bold text-navy-900 mb-2">Access Opportunities</h3>
          <p class="text-sm text-navy-600">Get matched with government challenges</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-navy-100 text-navy-700 text-2xl flex items-center justify-center mx-auto mb-4">🤝</div>
          <h3 class="font-bold text-navy-900 mb-2">Pilot Support</h3>
          <p class="text-sm text-navy-600">Receive funding and resources for pilots</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-navy-100 text-navy-700 text-2xl flex items-center justify-center mx-auto mb-4">📈</div>
          <h3 class="font-bold text-navy-900 mb-2">Scale Solutions</h3>
          <p class="text-sm text-navy-600">Grow successful pilots nationwide</p>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<script>
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you for your application! Our team will review it and get back to you within 5-7 business days.');
      form.reset();
    });
  }
</script>
