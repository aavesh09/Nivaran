---
import Layout from '../../layouts/Layout.astro';
import PilotCard from '../../components/PilotCard.astro';
import Badge from '../../components/Badge.astro';

import pilots from '../../data/pilots.json';
import problems from '../../data/problems.json';
import startups from '../../data/startups.json';

const breadcrumbs = [
  { label: 'Dashboard', href: '/' },
  { label: 'Pilots' },
];

const activePilots = pilots.filter(p => p.status === 'active');
const completedPilots = pilots.filter(p => p.status === 'completed');
---

<Layout pageTitle="Pilots" breadcrumbs={breadcrumbs}>
  <div class="flex items-center justify-between mb-8 animate-fade-in">
    <div>
      <h1 class="font-display text-3xl font-bold text-text-primary">Pilot Programs</h1>
      <p class="text-text-secondary mt-1">{pilots.length} pilots — {activePilots.length} active, {completedPilots.length} completed</p>
    </div>
    <a
      href="/pilots/new"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-teal-500 to-blue-500 text-white font-medium text-sm transition-all hover:shadow-lg hover:shadow-teal-500/25 hover:-translate-y-0.5"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Launch Pilot
    </a>
  </div>

  <!-- Status tabs -->
  <div class="flex items-center gap-2 mb-6 animate-slide-up opacity-0" style="animation-fill-mode: forwards;">
    <button class="pilot-tab active px-4 py-2 rounded-xl text-sm font-medium bg-teal-500/15 text-teal-400 border border-teal-500/20" data-filter="all">
      All <span class="text-xs opacity-70">({pilots.length})</span>
    </button>
    <button class="pilot-tab px-4 py-2 rounded-xl text-sm font-medium text-text-secondary hover:bg-white/[0.04] border border-transparent" data-filter="active">
      Active <span class="text-xs opacity-70">({activePilots.length})</span>
    </button>
    <button class="pilot-tab px-4 py-2 rounded-xl text-sm font-medium text-text-secondary hover:bg-white/[0.04] border border-transparent" data-filter="completed">
      Completed <span class="text-xs opacity-70">({completedPilots.length})</span>
    </button>
  </div>

  <!-- Pilots grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="pilots-grid">
    {pilots.map((pilot, i) => {
      const problem = problems.find(p => p.id === pilot.problemId);
      const startup = startups.find(s => s.id === pilot.startupId);
      return (
        <div
          class="pilot-item animate-slide-up opacity-0"
          data-status={pilot.status}
          style={`animation-delay: ${i * 80}ms; animation-fill-mode: forwards;`}
        >
          <PilotCard {...pilot} problemTitle={problem?.title} startupName={startup?.name} />
        </div>
      );
    })}
  </div>
</Layout>

<script>
  document.querySelectorAll('.pilot-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = (tab as HTMLElement).dataset.filter;

      document.querySelectorAll('.pilot-tab').forEach(t => {
        t.classList.remove('active', 'bg-teal-500/15', 'text-teal-400', 'border-teal-500/20');
        t.classList.add('text-text-secondary', 'border-transparent');
      });
      tab.classList.add('active', 'bg-teal-500/15', 'text-teal-400', 'border-teal-500/20');
      tab.classList.remove('text-text-secondary', 'border-transparent');

      document.querySelectorAll('.pilot-item').forEach(item => {
        const el = item as HTMLElement;
        if (filter === 'all' || el.dataset.status === filter) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
