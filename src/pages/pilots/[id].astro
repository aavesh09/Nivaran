---
import Layout from '../../layouts/Layout.astro';
import KpiGauge from '../../components/KpiGauge.astro';
import Badge from '../../components/Badge.astro';

import pilots from '../../data/pilots.json';
import problems from '../../data/problems.json';
import startups from '../../data/startups.json';

export function getStaticPaths() {
  return pilots.map(p => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const pilot = pilots.find(p => p.id === id);

if (!pilot) {
  return Astro.redirect('/pilots');
}

const problem = problems.find(p => p.id === pilot.problemId);
const startup = startups.find(s => s.id === pilot.startupId);

const breadcrumbs = [
  { label: 'Dashboard', href: '/' },
  { label: 'Pilots', href: '/pilots' },
  { label: pilot.title.split(' — ')[0] },
];

const statusVariant = {
  active: 'success',
  completed: 'neutral',
  extended: 'info',
} as const;

const outcomeLabels: Record<string, string> = {
  scale: '🚀 Scale Up',
  extend: '🔄 Extend Pilot',
  'do-not-scale': '⏹️ Do Not Scale',
};

const outcomeColors: Record<string, string> = {
  scale: 'from-emerald-500 to-emerald-600',
  extend: 'from-blue-500 to-blue-600',
  'do-not-scale': 'from-red-500 to-red-600',
};

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const daysLeft = Math.max(0, Math.ceil((new Date(pilot.endDate).getTime() - Date.now()) / (1000 * 60 * 60 * 24)));
const totalDays = Math.ceil((new Date(pilot.endDate).getTime() - new Date(pilot.startDate).getTime()) / (1000 * 60 * 60 * 24));
const daysPassed = totalDays - daysLeft;
const timeProgress = Math.min(100, Math.round((daysPassed / totalDays) * 100));

// Calculate average KPI progress
const avgProgress = pilot.kpis.length > 0
  ? Math.round(pilot.kpis.reduce((sum, kpi) => {
      const isLowerBetter = kpi.target < kpi.baseline;
      let p: number;
      if (isLowerBetter) {
        const range = kpi.baseline - kpi.target;
        const achieved = kpi.baseline - kpi.current;
        p = range > 0 ? (achieved / range) * 100 : 0;
      } else {
        const range = kpi.target - kpi.baseline;
        const achieved = kpi.current - kpi.baseline;
        p = range > 0 ? (achieved / range) * 100 : 0;
      }
      return sum + Math.max(0, Math.min(p, 100));
    }, 0) / pilot.kpis.length)
  : 0;
---

<Layout pageTitle={pilot.title} breadcrumbs={breadcrumbs}>
  <!-- Header -->
  <div class="mb-8 animate-fade-in">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="font-display text-2xl lg:text-3xl font-bold text-text-primary">{pilot.title}</h1>
        <p class="text-text-secondary mt-2">
          {formatDate(pilot.startDate)} → {formatDate(pilot.endDate)}
          {pilot.status === 'active' && <span class="text-teal-400 ml-2">· {daysLeft} days remaining</span>}
        </p>
      </div>
      <div class="flex items-center gap-2">
        <Badge variant={statusVariant[pilot.status as keyof typeof statusVariant] || 'neutral'} size="md">
          {pilot.status}
        </Badge>
        {pilot.outcome && (
          <Badge variant={pilot.outcome === 'scale' ? 'success' : pilot.outcome === 'extend' ? 'info' : 'danger'} size="md">
            {outcomeLabels[pilot.outcome] || pilot.outcome}
          </Badge>
        )}
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <!-- Main content -->
    <div class="xl:col-span-2 space-y-6">
      <!-- Timeline progress -->
      <div class="glass p-6 space-y-4 animate-slide-up opacity-0" style="animation-fill-mode: forwards;">
        <h2 class="font-display text-lg font-bold text-text-primary">Pilot Timeline</h2>
        <div class="space-y-2">
          <div class="flex items-center justify-between text-sm">
            <span class="text-text-secondary">{formatDate(pilot.startDate)}</span>
            <span class="font-medium text-teal-400">{timeProgress}% elapsed</span>
            <span class="text-text-secondary">{formatDate(pilot.endDate)}</span>
          </div>
          <div class="w-full h-3 rounded-full bg-white/5 overflow-hidden">
            <div
              class="h-full rounded-full bg-gradient-to-r from-teal-400 to-blue-500 transition-all duration-1000"
              style={`width: ${timeProgress}%;`}
            />
          </div>
        </div>
      </div>

      <!-- KPI Dashboard -->
      <div class="space-y-4 animate-slide-up opacity-0" style="animation-delay: 100ms; animation-fill-mode: forwards;">
        <div class="flex items-center justify-between">
          <h2 class="font-display text-lg font-bold text-text-primary">KPI Dashboard</h2>
          <span class="text-sm text-text-secondary">
            Overall: <span class={`font-bold ${avgProgress >= 70 ? 'text-emerald-400' : avgProgress >= 40 ? 'text-blue-400' : 'text-amber-400'}`}>{avgProgress}%</span>
          </span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {pilot.kpis.map((kpi, i) => (
            <div class="animate-scale-in opacity-0" style={`animation-delay: ${(i + 2) * 100}ms; animation-fill-mode: forwards;`}>
              <KpiGauge {...kpi} />
            </div>
          ))}
        </div>
      </div>

      <!-- Outcome Decision (for active pilots) -->
      {pilot.status === 'active' && (
        <div class="glass p-6 space-y-4 animate-slide-up opacity-0" style="animation-delay: 300ms; animation-fill-mode: forwards;">
          <h2 class="font-display text-lg font-bold text-text-primary">Pilot Outcome Decision</h2>
          <p class="text-sm text-text-secondary">Based on KPI performance, select an outcome for this pilot.</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="outcome-buttons">
            <button data-outcome="scale" data-pilot-id={pilot.id} class="outcome-btn px-4 py-4 rounded-xl border border-emerald-500/20 bg-emerald-500/5 text-emerald-400 hover:bg-emerald-500/15 transition-all text-center space-y-1">
              <div class="text-2xl">🚀</div>
              <div class="text-sm font-bold">Scale Up</div>
              <div class="text-xs opacity-70">Proceed to full deployment</div>
            </button>
            <button data-outcome="extend" data-pilot-id={pilot.id} class="outcome-btn px-4 py-4 rounded-xl border border-blue-500/20 bg-blue-500/5 text-blue-400 hover:bg-blue-500/15 transition-all text-center space-y-1">
              <div class="text-2xl">🔄</div>
              <div class="text-sm font-bold">Extend Pilot</div>
              <div class="text-xs opacity-70">More time needed</div>
            </button>
            <button data-outcome="do-not-scale" data-pilot-id={pilot.id} class="outcome-btn px-4 py-4 rounded-xl border border-red-500/20 bg-red-500/5 text-red-400 hover:bg-red-500/15 transition-all text-center space-y-1">
              <div class="text-2xl">⏹️</div>
              <div class="text-sm font-bold">Do Not Scale</div>
              <div class="text-xs opacity-70">End the pilot</div>
            </button>
          </div>
          <div id="outcome-success" class="hidden text-center py-4 space-y-2 animate-scale-in">
            <div class="text-3xl">✅</div>
            <p class="text-sm text-text-primary font-medium">Outcome recorded successfully!</p>
            <a href="/reports" class="text-xs text-teal-400 hover:text-teal-300">View Reports →</a>
          </div>
        </div>
      )}

      <!-- Completed Outcome Display -->
      {pilot.outcome && (
        <div class={`glass p-6 border-l-4 ${
          pilot.outcome === 'scale' ? 'border-l-emerald-500' :
          pilot.outcome === 'extend' ? 'border-l-blue-500' : 'border-l-red-500'
        } animate-slide-up opacity-0`} style="animation-delay: 300ms; animation-fill-mode: forwards;">
          <h2 class="font-display text-lg font-bold text-text-primary mb-2">Pilot Outcome</h2>
          <div class="flex items-center gap-3">
            <span class="text-3xl">
              {pilot.outcome === 'scale' ? '🚀' : pilot.outcome === 'extend' ? '🔄' : '⏹️'}
            </span>
            <div>
              <p class="font-bold text-text-primary">{outcomeLabels[pilot.outcome]}</p>
              <p class="text-sm text-text-secondary mt-1">
                {pilot.outcome === 'scale' ? 'This pilot has been approved for full-scale deployment.' :
                 pilot.outcome === 'extend' ? 'This pilot has been extended for further evaluation.' :
                 'This pilot has been concluded without scaling.'}
              </p>
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Sidebar info -->
    <div class="space-y-6">
      <!-- Problem info -->
      {problem && (
        <div class="glass p-5 space-y-3 animate-slide-right opacity-0" style="animation-delay: 100ms; animation-fill-mode: forwards;">
          <h3 class="font-display font-bold text-text-primary text-sm uppercase tracking-wider text-text-muted">Problem</h3>
          <div>
            <p class="font-medium text-text-primary">{problem.title}</p>
            <p class="text-xs text-text-muted mt-1">{problem.department}</p>
          </div>
          <p class="text-sm text-text-secondary line-clamp-3">{problem.description}</p>
          <div class="flex items-center gap-2">
            <Badge variant="accent" size="sm">{problem.domain}</Badge>
            <span class="text-xs text-text-muted">${(problem.budget / 1000).toFixed(0)}K budget</span>
          </div>
        </div>
      )}

      <!-- Startup info -->
      {startup && (
        <div class="glass p-5 space-y-3 animate-slide-right opacity-0" style="animation-delay: 200ms; animation-fill-mode: forwards;">
          <h3 class="font-display font-bold text-sm uppercase tracking-wider text-text-muted">Startup</h3>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500/20 to-blue-500/20 border border-white/10 flex items-center justify-center font-bold text-xs text-teal-400">
              {startup.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()}
            </div>
            <div>
              <p class="font-medium text-text-primary">{startup.name}</p>
              <p class="text-xs text-text-muted">{startup.location} · {startup.teamSize} people</p>
            </div>
          </div>
          <p class="text-sm text-text-secondary line-clamp-3">{startup.description}</p>
          <div class="flex items-center gap-2 flex-wrap">
            {startup.domains.map(d => (
              <Badge variant="accent" size="sm">{d}</Badge>
            ))}
            <Badge variant={startup.stage === 'growth' ? 'success' : 'warning'} size="sm">{startup.stage}</Badge>
          </div>
        </div>
      )}

      <!-- KPI summary stats -->
      <div class="glass p-5 space-y-3 animate-slide-right opacity-0" style="animation-delay: 300ms; animation-fill-mode: forwards;">
        <h3 class="font-display font-bold text-sm uppercase tracking-wider text-text-muted">Quick Stats</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-secondary">KPIs Tracked</span>
            <span class="font-bold text-text-primary">{pilot.kpis.length}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-secondary">Avg Progress</span>
            <span class={`font-bold ${avgProgress >= 70 ? 'text-emerald-400' : avgProgress >= 40 ? 'text-blue-400' : 'text-amber-400'}`}>{avgProgress}%</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-secondary">Duration</span>
            <span class="font-bold text-text-primary">{totalDays} days</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-secondary">Time Elapsed</span>
            <span class="font-bold text-teal-400">{timeProgress}%</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { setOutcome, initStore } from '../../scripts/store.js';
  import problemsData from '../../data/problems.json';
  import pilotsData from '../../data/pilots.json';

  initStore(problemsData, pilotsData);

  document.querySelectorAll('.outcome-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const outcome = (btn as HTMLElement).dataset.outcome;
      const pilotId = (btn as HTMLElement).dataset.pilotId;

      if (outcome && pilotId && confirm(`Are you sure you want to set the outcome to "${outcome.replace('-', ' ')}"?`)) {
        setOutcome(pilotId, outcome);

        const buttons = document.getElementById('outcome-buttons');
        const success = document.getElementById('outcome-success');
        if (buttons) buttons.style.display = 'none';
        if (success) success.classList.remove('hidden');
      }
    });
  });
</script>
