---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { label: 'Dashboard', href: '/' },
  { label: '404 - Not Found' },
];
---

<Layout title="404 — Page Not Found | PilotSetu" pageTitle="Page Not Found" breadcrumbs={breadcrumbs}>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="w-20 h-20 rounded-2xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 mb-6">
      <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h1 class="text-4xl font-bold font-display text-text-primary mb-3">404 — Page Not Found</h1>
    <p class="text-text-secondary max-w-md mb-8">
      The requested resource or page could not be located in the PilotSetu system.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-teal-500 text-navy-950 font-semibold text-sm hover:bg-teal-400 transition-all shadow-lg shadow-teal-500/20"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Return to Dashboard
    </a>
  </div>
</Layout>
