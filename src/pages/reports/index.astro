---
import Layout from '../../layouts/Layout.astro';
import StatCard from '../../components/StatCard.astro';
import Badge from '../../components/Badge.astro';
import KpiGauge from '../../components/KpiGauge.astro';

import pilots from '../../data/pilots.json';
import problems from '../../data/problems.json';
import startups from '../../data/startups.json';

const breadcrumbs = [
  { label: 'Dashboard', href: '/' },
  { label: 'Reports' },
];

const completedPilots = pilots.filter(p => p.status === 'completed');
const activePilots = pilots.filter(p => p.status === 'active');
const allPilots = pilots;

const scaled = completedPilots.filter(p => p.outcome === 'scale');
const extended = completedPilots.filter(p => p.outcome === 'extend');
const notScaled = completedPilots.filter(p => p.outcome === 'do-not-scale');
const successRate = completedPilots.length > 0 ? Math.round((scaled.length / completedPilots.length) * 100) : 0;

// Average pilot duration
const avgDuration = allPilots.length > 0
  ? Math.round(allPilots.reduce((sum, p) => {
      return sum + Math.ceil((new Date(p.endDate).getTime() - new Date(p.startDate).getTime()) / (1000 * 60 * 60 * 24));
    }, 0) / allPilots.length)
  : 0;

// Domain performance
const domainStats: Record<string, { total: number; scaled: number }> = {};
completedPilots.forEach(pilot => {
  const problem = problems.find(p => p.id === pilot.problemId);
  if (problem) {
    if (!domainStats[problem.domain]) domainStats[problem.domain] = { total: 0, scaled: 0 };
    domainStats[problem.domain].total++;
    if (pilot.outcome === 'scale') domainStats[problem.domain].scaled++;
  }
});

const domainIcons: Record<string, string> = {
  traffic: '🚦', waste: '♻️', water: '💧', safety: '🛡️',
  energy: '⚡', digital: '💻', environment: '🌿',
};

const outcomeLabels: Record<string, string> = {
  scale: '🚀 Scale',
  extend: '🔄 Extend',
  'do-not-scale': '⏹️ Do Not Scale',
};

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout pageTitle="Reports" breadcrumbs={breadcrumbs}>
  <div class="mb-8 animate-fade-in">
    <h1 class="font-display text-3xl font-bold text-text-primary">
      Pilot <span class="gradient-text">Reports</span>
    </h1>
    <p class="text-text-secondary mt-2">Comprehensive overview of pilot outcomes and platform performance.</p>
  </div>

  <!-- Summary stats -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">
    <StatCard label="Total Pilots" value={allPilots.length} icon="🔬" delay={0} />
    <StatCard label="Success Rate" value={`${successRate}%`} icon="🎯" trend={`${scaled.length} scaled`} trendUp={successRate >= 50} delay={100} />
    <StatCard label="Avg Duration" value={`${avgDuration}d`} icon="⏱️" delay={200} />
    <StatCard label="Active Pilots" value={activePilots.length} icon="🚀" trend="In progress" trendUp={true} delay={300} />
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <!-- Outcome distribution -->
    <div class="glass p-6 space-y-5 animate-slide-up opacity-0" style="animation-fill-mode: forwards;">
      <h2 class="font-display text-lg font-bold text-text-primary">Outcome Distribution</h2>

      {completedPilots.length > 0 ? (
        <div class="space-y-4">
          <!-- Visual bar chart -->
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="text-sm w-24 text-text-secondary">Scale</span>
              <div class="flex-1 h-8 rounded-lg bg-white/5 overflow-hidden">
                <div class="h-full rounded-lg bg-gradient-to-r from-emerald-400 to-emerald-500 flex items-center px-3 text-xs font-bold text-white transition-all duration-1000" style={`width: ${completedPilots.length > 0 ? (scaled.length / completedPilots.length) * 100 : 0}%;`}>
                  {scaled.length}
                </div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-sm w-24 text-text-secondary">Extend</span>
              <div class="flex-1 h-8 rounded-lg bg-white/5 overflow-hidden">
                <div class="h-full rounded-lg bg-gradient-to-r from-blue-400 to-blue-500 flex items-center px-3 text-xs font-bold text-white transition-all duration-1000" style={`width: ${completedPilots.length > 0 ? (extended.length / completedPilots.length) * 100 : 0}%;`}>
                  {extended.length}
                </div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-sm w-24 text-text-secondary">Not Scaled</span>
              <div class="flex-1 h-8 rounded-lg bg-white/5 overflow-hidden">
                <div class="h-full rounded-lg bg-gradient-to-r from-red-400 to-red-500 flex items-center px-3 text-xs font-bold text-white transition-all duration-1000" style={`width: ${completedPilots.length > 0 ? (notScaled.length / completedPilots.length) * 100 : 0}%;`}>
                  {notScaled.length}
                </div>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-white/[0.06] text-xs text-text-muted text-center">
            Based on {completedPilots.length} completed pilot{completedPilots.length !== 1 ? 's' : ''}
          </div>
        </div>
      ) : (
        <p class="text-sm text-text-muted text-center py-8">No completed pilots yet.</p>
      )}
    </div>

    <!-- Completed pilot reports -->
    <div class="xl:col-span-2 space-y-4">
      <h2 class="font-display text-lg font-bold text-text-primary">Pilot Outcome Reports</h2>

      {completedPilots.length > 0 ? (
        <div class="space-y-4">
          {completedPilots.map((pilot, i) => {
            const problem = problems.find(p => p.id === pilot.problemId);
            const startup = startups.find(s => s.id === pilot.startupId);

            const avgProgress = pilot.kpis.length > 0
              ? Math.round(pilot.kpis.reduce((sum, kpi) => {
                  const isLowerBetter = kpi.target < kpi.baseline;
                  let p: number;
                  if (isLowerBetter) {
                    const range = kpi.baseline - kpi.target;
                    const achieved = kpi.baseline - kpi.current;
                    p = range > 0 ? (achieved / range) * 100 : 0;
                  } else {
                    const range = kpi.target - kpi.baseline;
                    const achieved = kpi.current - kpi.baseline;
                    p = range > 0 ? (achieved / range) * 100 : 0;
                  }
                  return sum + Math.max(0, Math.min(p, 100));
                }, 0) / pilot.kpis.length)
              : 0;

            return (
              <div
                class={`glass p-6 space-y-4 border-l-4 animate-slide-up opacity-0 ${
                  pilot.outcome === 'scale' ? 'border-l-emerald-500' :
                  pilot.outcome === 'extend' ? 'border-l-blue-500' : 'border-l-red-500'
                }`}
                style={`animation-delay: ${i * 100}ms; animation-fill-mode: forwards;`}
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="font-display font-bold text-text-primary">{pilot.title}</h3>
                    <p class="text-xs text-text-muted mt-1">
                      {formatDate(pilot.startDate)} → {formatDate(pilot.endDate)}
                      {startup && <span> · {startup.name}</span>}
                    </p>
                  </div>
                  {pilot.outcome && (
                    <Badge variant={pilot.outcome === 'scale' ? 'success' : pilot.outcome === 'extend' ? 'info' : 'danger'} size="md">
                      {outcomeLabels[pilot.outcome]}
                    </Badge>
                  )}
                </div>

                <!-- KPI summary row -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
                  {pilot.kpis.map(kpi => {
                    const isLowerBetter = kpi.target < kpi.baseline;
                    let progress: number;
                    if (isLowerBetter) {
                      const range = kpi.baseline - kpi.target;
                      const achieved = kpi.baseline - kpi.current;
                      progress = range > 0 ? Math.round((achieved / range) * 100) : 0;
                    } else {
                      const range = kpi.target - kpi.baseline;
                      const achieved = kpi.current - kpi.baseline;
                      progress = range > 0 ? Math.round((achieved / range) * 100) : 0;
                    }
                    progress = Math.max(0, Math.min(progress, 100));

                    return (
                      <div class="glass-sm p-3 space-y-1.5">
                        <p class="text-[10px] uppercase tracking-wider text-text-muted">{kpi.name}</p>
                        <p class={`text-lg font-bold ${progress >= 80 ? 'text-emerald-400' : progress >= 50 ? 'text-blue-400' : 'text-amber-400'}`}>
                          {kpi.current} <span class="text-xs text-text-muted font-normal">{kpi.unit}</span>
                        </p>
                        <div class="w-full h-1.5 rounded-full bg-white/5 overflow-hidden">
                          <div
                            class={`h-full rounded-full ${progress >= 80 ? 'bg-emerald-400' : progress >= 50 ? 'bg-blue-400' : 'bg-amber-400'}`}
                            style={`width: ${progress}%;`}
                          />
                        </div>
                      </div>
                    );
                  })}
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-white/[0.06]">
                  <span class="text-xs text-text-muted">
                    Overall: <span class={`font-bold ${avgProgress >= 70 ? 'text-emerald-400' : 'text-blue-400'}`}>{avgProgress}%</span>
                  </span>
                  <a href={`/pilots/${pilot.id}`} class="text-xs text-teal-400 hover:text-teal-300 transition-colors">
                    View Details →
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="glass p-12 text-center space-y-4">
          <div class="text-5xl">📊</div>
          <h3 class="font-display text-lg font-bold text-text-primary">No Completed Pilots</h3>
          <p class="text-sm text-text-secondary">Reports will appear here once pilots are completed with an outcome decision.</p>
        </div>
      )}
    </div>
  </div>

  <!-- Domain performance (if data exists) -->
  {Object.keys(domainStats).length > 0 && (
    <div class="mt-8 glass p-6 space-y-4 animate-slide-up opacity-0" style="animation-delay: 400ms; animation-fill-mode: forwards;">
      <h2 class="font-display text-lg font-bold text-text-primary">Performance by Domain</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {Object.entries(domainStats).map(([domain, stats]) => (
          <div class="glass-sm p-4 text-center space-y-2">
            <span class="text-2xl">{domainIcons[domain] || '📋'}</span>
            <p class="text-sm font-medium text-text-primary capitalize">{domain}</p>
            <p class="text-xs text-text-muted">{stats.total} pilot{stats.total !== 1 ? 's' : ''}</p>
            <p class={`text-lg font-bold ${stats.scaled > 0 ? 'text-emerald-400' : 'text-text-secondary'}`}>
              {stats.total > 0 ? Math.round((stats.scaled / stats.total) * 100) : 0}%
              <span class="text-xs text-text-muted font-normal ml-1">scaled</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  )}
</Layout>
