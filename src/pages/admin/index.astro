---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/StatCard.astro';
import PilotCard from '../../components/PilotCard.astro';
import ProblemCard from '../../components/ProblemCard.astro';
import Badge from '../../components/Badge.astro';

import problems from '../../data/problems.json';
import startups from '../../data/startups.json';
import pilots from '../../data/pilots.json';

const activePilots = pilots.filter(p => p.status === 'active');
const completedPilots = pilots.filter(p => p.status === 'completed');
const scaledPilots = completedPilots.filter(p => p.outcome === 'scale');
const successRate = completedPilots.length > 0 ? Math.round((scaledPilots.length / completedPilots.length) * 100) : 0;
const openProblems = problems.filter(p => p.status === 'open');
const recentProblems = problems.slice(0, 3);

const breadcrumbs = [{ label: 'Admin Dashboard' }];
---

<AdminLayout pageTitle="Dashboard" breadcrumbs={breadcrumbs}>
  <!-- Page heading -->
  <div class="mb-6 lg:mb-8 animate-fade-in">
    <h1 class="font-display text-3xl lg:text-4xl font-bold text-navy-900">
      Admin <span class="gradient-text">Dashboard</span>
    </h1>
    <p class="text-navy-600 mt-2 text-base lg:text-lg font-medium">Government innovation management at a glance.</p>
  </div>

  <!-- Clickable Stat cards with navigation -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-5 mb-8 lg:mb-10">
    <a href="/admin/problems" class="block group">
      <StatCard label="Total Problems" value={problems.length} icon="📋" trend="+2 this week" trendUp={true} delay={0} clickable={true} />
    </a>
    <a href="/admin/pilots" class="block group">
      <StatCard label="Active Pilots" value={activePilots.length} icon="🚀" trend="On track" trendUp={true} delay={100} clickable={true} />
    </a>
    <a href="/admin/startups" class="block group">
      <StatCard label="Matched Startups" value={pilots.length} icon="🤝" delay={200} clickable={true} />
    </a>
    <a href="/admin/reports" class="block group">
      <StatCard label="Success Rate" value={`${successRate}%`} icon="🎯" trend={`${scaledPilots.length} scaled`} trendUp={successRate > 50} delay={300} clickable={true} />
    </a>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-5 lg:gap-6">
    <!-- Active Pilots -->
    <div class="xl:col-span-2 space-y-4 lg:space-y-5">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-xl lg:text-2xl font-bold text-navy-900 flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-sage-500 to-sage-600 flex items-center justify-center text-white text-sm">🚀</span>
          Active Pilots
        </h2>
        <a href="/admin/pilots" class="text-sm font-bold text-sage-700 hover:text-sage-800 transition-colors flex items-center gap-1.5 px-3 py-2 rounded-lg hover:bg-sage-100">
          View all
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
      <div class="space-y-4">
        {activePilots.map((pilot, i) => {
          const problem = problems.find(p => p.id === pilot.problemId);
          const startup = startups.find(s => s.id === pilot.startupId);
          return (
            <div class="animate-slide-up opacity-0" style={`animation-delay: ${(i + 1) * 100}ms; animation-fill-mode: forwards;`}>
              <PilotCard {...pilot} problemTitle={problem?.title} startupName={startup?.name} />
            </div>
          );
        })}
      </div>
    </div>

    <!-- Right sidebar -->
    <div class="space-y-5 lg:space-y-6">
      <!-- Enhanced Quick Actions -->
      <div class="glass p-5 lg:p-6 space-y-4 animate-slide-up opacity-0 border-2 border-navy-200" style="animation-delay: 200ms; animation-fill-mode: forwards;">
        <h3 class="font-display font-bold text-navy-900 text-lg lg:text-xl flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-navy-600 to-navy-700 flex items-center justify-center text-white text-xs">⚡</span>
          Quick Actions
        </h3>
        <div class="space-y-3">
          <a href="/admin/problems/new" class="flex items-center gap-3 px-4 py-3.5 rounded-lg bg-gradient-to-r from-sage-500 to-sage-600 text-white font-bold text-sm hover:from-sage-600 hover:to-sage-700 transition-all shadow-md hover:shadow-lg hover:scale-[1.02] group">
            <span class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center group-hover:rotate-90 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </span>
            <span>Add New Problem</span>
          </a>
          <a href="/admin/startups/match" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-white border-2 border-navy-300 text-navy-800 font-bold text-sm hover:bg-sage-50 hover:border-sage-400 transition-all hover:shadow-md group">
            <span class="w-7 h-7 rounded-lg bg-navy-100 text-navy-700 flex items-center justify-center group-hover:bg-sage-200 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
            </span>
            Match Startups
          </a>
          <a href="/admin/pilots/new" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-white border-2 border-navy-300 text-navy-800 font-bold text-sm hover:bg-sage-50 hover:border-sage-400 transition-all hover:shadow-md group">
            <span class="w-7 h-7 rounded-lg bg-navy-100 text-navy-700 flex items-center justify-center group-hover:bg-sage-200 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12" />
              </svg>
            </span>
            Launch Pilot
          </a>
        </div>
      </div>

      <!-- Recent Problems -->
      <div class="animate-slide-up opacity-0" style="animation-delay: 350ms; animation-fill-mode: forwards;">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-display font-bold text-navy-900 text-lg lg:text-xl flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-navy-600 to-navy-700 flex items-center justify-center text-white text-xs">📋</span>
            Recent Problems
          </h3>
          <a href="/admin/problems" class="text-sm font-bold text-sage-700 hover:text-sage-800 transition-colors">View all →</a>
        </div>
        <div class="space-y-3">
          {recentProblems.map(problem => (
            <ProblemCard {...problem} />
          ))}
        </div>
      </div>

      <!-- Completed Pilots Summary -->
      <div class="glass p-5 lg:p-6 space-y-4 animate-slide-up opacity-0 border-2 border-navy-200" style="animation-delay: 450ms; animation-fill-mode: forwards;">
        <h3 class="font-display font-bold text-navy-900 text-lg lg:text-xl flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-navy-600 to-navy-700 flex items-center justify-center text-white text-xs">✅</span>
          Completed Pilots
        </h3>
        <div class="space-y-2">
          {completedPilots.map(pilot => (
            <a href={`/admin/pilots/${pilot.id}`} class="flex items-center justify-between py-3 px-4 rounded-lg hover:bg-sage-50 transition-colors group border-2 border-transparent hover:border-sage-300">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-bold text-navy-900 truncate group-hover:text-sage-700 transition-colors">{pilot.title.split(' — ')[0]}</p>
              </div>
              {pilot.outcome && (
                <Badge variant={pilot.outcome === 'scale' ? 'success' : pilot.outcome === 'extend' ? 'info' : 'danger'}>
                  {pilot.outcome === 'scale' ? '🚀 Scale' : pilot.outcome === 'extend' ? '🔄 Extend' : '⏹️ Stop'}
                </Badge>
              )}
            </a>
          ))}
        </div>
        <a href="/admin/reports" class="block text-center text-sm font-bold text-sage-700 hover:text-sage-800 transition-colors pt-3 border-t-2 border-navy-200">
          View Full Reports →
        </a>
      </div>
    </div>
  </div>

  <!-- Floating Action Button (FAB) -->
  <div class="fixed bottom-6 right-6 z-30" id="fab-container">
    <div id="fab-menu" class="absolute bottom-16 right-0 space-y-3 mb-2 hidden">
      <a href="/admin/problems/new" class="flex items-center gap-3 bg-white border-2 border-navy-300 text-navy-800 px-4 py-3 rounded-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all group">
        <span class="font-bold text-sm whitespace-nowrap">New Problem</span>
        <span class="w-8 h-8 rounded-lg bg-navy-100 flex items-center justify-center">📋</span>
      </a>
      <a href="/admin/pilots/new" class="flex items-center gap-3 bg-white border-2 border-navy-300 text-navy-800 px-4 py-3 rounded-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all group">
        <span class="font-bold text-sm whitespace-nowrap">New Pilot</span>
        <span class="w-8 h-8 rounded-lg bg-navy-100 flex items-center justify-center">🚀</span>
      </a>
      <a href="/admin/startups/match" class="flex items-center gap-3 bg-white border-2 border-navy-300 text-navy-800 px-4 py-3 rounded-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all group">
        <span class="font-bold text-sm whitespace-nowrap">Match Startup</span>
        <span class="w-8 h-8 rounded-lg bg-navy-100 flex items-center justify-center">🔍</span>
      </a>
    </div>
    <button id="fab-button" class="w-14 h-14 rounded-full bg-gradient-to-br from-sage-500 to-sage-600 text-white shadow-xl hover:shadow-2xl hover:scale-110 transition-all flex items-center justify-center group">
      <svg id="fab-icon" class="w-7 h-7 transition-transform group-hover:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
    </button>
  </div>
</AdminLayout>

<script>
  import { initStore } from '../../scripts/store.js';
  import problemsData from '../../data/problems.json';
  import pilotsData from '../../data/pilots.json';

  initStore(problemsData, pilotsData);

  // FAB functionality
  const fabButton = document.getElementById('fab-button');
  const fabMenu = document.getElementById('fab-menu');
  const fabIcon = document.getElementById('fab-icon');

  if (fabButton && fabMenu && fabIcon) {
    fabButton.addEventListener('click', () => {
      const isOpen = !fabMenu.classList.contains('hidden');

      if (isOpen) {
        fabMenu.classList.add('hidden');
        fabIcon.style.transform = 'rotate(0deg)';
      } else {
        fabMenu.classList.remove('hidden');
        fabIcon.style.transform = 'rotate(45deg)';
      }
    });

    document.addEventListener('click', (e) => {
      const fabContainer = document.getElementById('fab-container');
      if (fabContainer && !fabContainer.contains(e.target as Node)) {
        fabMenu.classList.add('hidden');
        fabIcon.style.transform = 'rotate(0deg)';
      }
    });
  }
</script>
