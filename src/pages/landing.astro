---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout pageTitle="Home" transparentNav={true}>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
    <!-- Animated Background -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-1/4 -right-40 w-[40rem] h-[40rem] rounded-full bg-sage-300/30 blur-3xl animate-float" />
      <div class="absolute bottom-1/4 -left-40 w-[40rem] h-[40rem] rounded-full bg-navy-300/30 blur-3xl" style="animation: float 8s ease-in-out infinite; animation-delay: 2s;" />
    </div>

    <div class="max-w-7xl mx-auto px-4 lg:px-8 relative z-10">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sage-100 border-2 border-sage-300 text-sage-800 font-bold text-sm mb-6 animate-slide-up">
          <span class="w-2 h-2 rounded-full bg-sage-600 animate-pulse" />
          Transforming Government Innovation
        </div>

        <h1 class="font-display text-5xl lg:text-7xl font-bold text-navy-900 mb-6 animate-slide-up" style="animation-delay: 100ms; animation-fill-mode: backwards;">
          Connect Problems with
          <span class="block gradient-text mt-2">Innovative Solutions</span>
        </h1>

        <p class="text-xl lg:text-2xl text-navy-600 mb-10 max-w-3xl mx-auto font-medium animate-slide-up" style="animation-delay: 200ms; animation-fill-mode: backwards;">
          GovPilot bridges government challenges and startup innovations through pilot programs that drive real impact.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 animate-slide-up" style="animation-delay: 300ms; animation-fill-mode: backwards;">
          <a href="/user/submit" class="w-full sm:w-auto px-8 py-4 rounded-lg bg-gradient-to-r from-sage-500 to-sage-600 text-white font-bold text-lg hover:from-sage-600 hover:to-sage-700 transition-all shadow-xl hover:shadow-2xl hover:scale-105 flex items-center justify-center gap-2">
            <span>Submit a Problem</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/startup/apply" class="w-full sm:w-auto px-8 py-4 rounded-lg border-2 border-navy-300 text-navy-800 font-bold text-lg hover:bg-navy-50 hover:border-navy-400 transition-all flex items-center justify-center gap-2">
            <span>For Startups</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12" />
            </svg>
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 animate-slide-up" style="animation-delay: 400ms; animation-fill-mode: backwards;">
          <div class="glass p-6 border-2 border-navy-200">
            <div class="text-4xl lg:text-5xl font-bold text-navy-900 mb-2">50+</div>
            <div class="text-sm font-semibold text-navy-600">Active Problems</div>
          </div>
          <div class="glass p-6 border-2 border-navy-200">
            <div class="text-4xl lg:text-5xl font-bold text-navy-900 mb-2">30+</div>
            <div class="text-sm font-semibold text-navy-600">Pilot Programs</div>
          </div>
          <div class="glass p-6 border-2 border-navy-200">
            <div class="text-4xl lg:text-5xl font-bold text-navy-900 mb-2">85%</div>
            <div class="text-sm font-semibold text-navy-600">Success Rate</div>
          </div>
          <div class="glass p-6 border-2 border-navy-200">
            <div class="text-4xl lg:text-5xl font-bold text-navy-900 mb-2">100+</div>
            <div class="text-sm font-semibold text-navy-600">Partner Startups</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-navy-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
      </svg>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-20 lg:py-32 bg-white relative z-10">
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl lg:text-5xl font-bold text-navy-900 mb-4">
          How It Works
        </h2>
        <p class="text-xl text-navy-600 max-w-2xl mx-auto">
          A simple, transparent process from problem to solution
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <!-- Step 1 -->
        <div class="text-center group">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-sage-500 to-sage-600 text-white text-3xl font-bold flex items-center justify-center mx-auto mb-6 shadow-lg group-hover:shadow-xl group-hover:scale-110 transition-all">
            1
          </div>
          <h3 class="font-display text-2xl font-bold text-navy-900 mb-3">Submit Problem</h3>
          <p class="text-navy-600">Government agencies identify challenges and submit them to the platform</p>
        </div>

        <!-- Step 2 -->
        <div class="text-center group">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-sage-500 to-sage-600 text-white text-3xl font-bold flex items-center justify-center mx-auto mb-6 shadow-lg group-hover:shadow-xl group-hover:scale-110 transition-all">
            2
          </div>
          <h3 class="font-display text-2xl font-bold text-navy-900 mb-3">Match Startups</h3>
          <p class="text-navy-600">AI-powered matching connects problems with qualified startup solutions</p>
        </div>

        <!-- Step 3 -->
        <div class="text-center group">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-sage-500 to-sage-600 text-white text-3xl font-bold flex items-center justify-center mx-auto mb-6 shadow-lg group-hover:shadow-xl group-hover:scale-110 transition-all">
            3
          </div>
          <h3 class="font-display text-2xl font-bold text-navy-900 mb-3">Run Pilots</h3>
          <p class="text-navy-600">Successful matches run pilot programs with clear KPIs and outcomes</p>
        </div>
      </div>
    </div>
  </section>

  <!-- For Citizens Section -->
  <section class="py-20 lg:py-32 bg-gradient-to-br from-sage-50 to-navy-50 relative z-10">
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border-2 border-sage-300 text-sage-700 font-bold text-sm mb-4">
            👥 For Citizens
          </div>
          <h2 class="font-display text-4xl lg:text-5xl font-bold text-navy-900 mb-6">
            Have a Problem? We Want to Hear It
          </h2>
          <p class="text-xl text-navy-600 mb-8">
            Your insights help shape government innovation. Submit challenges you face and help us find solutions that matter.
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-sage-500 text-white flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
              <span class="text-navy-700 font-medium">Quick and easy submission process</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-sage-500 text-white flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
              <span class="text-navy-700 font-medium">Track progress on your submission</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-sage-500 text-white flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
              <span class="text-navy-700 font-medium">See real solutions implemented</span>
            </li>
          </ul>
          <a href="/user/submit" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-gradient-to-r from-sage-500 to-sage-600 text-white font-bold text-lg hover:from-sage-600 hover:to-sage-700 transition-all shadow-lg hover:shadow-xl">
            Submit Your Problem
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
        <div class="glass p-8 border-2 border-navy-200">
          <div class="aspect-square rounded-lg bg-gradient-to-br from-sage-100 to-navy-100 flex items-center justify-center">
            <span class="text-8xl">👥</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- For Startups Section -->
  <section class="py-20 lg:py-32 bg-white relative z-10">
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <div class="glass p-8 border-2 border-navy-200">
            <div class="aspect-square rounded-lg bg-gradient-to-br from-navy-100 to-sage-100 flex items-center justify-center">
              <span class="text-8xl">🚀</span>
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border-2 border-navy-300 text-navy-700 font-bold text-sm mb-4">
            🚀 For Startups
          </div>
          <h2 class="font-display text-4xl lg:text-5xl font-bold text-navy-900 mb-6">
            Turn Government Challenges Into Opportunities
          </h2>
          <p class="text-xl text-navy-600 mb-8">
            Access real government problems, run pilot programs, and scale your solution with institutional support.
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-navy-700 text-white flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
              <span class="text-navy-700 font-medium">Access to verified government challenges</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-navy-700 text-white flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
              <span class="text-navy-700 font-medium">Pilot program funding and support</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-navy-700 text-white flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
              <span class="text-navy-700 font-medium">Scale successful pilots nationwide</span>
            </li>
          </ul>
          <a href="/startup/apply" class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-navy-700 text-white font-bold text-lg hover:bg-navy-800 transition-all shadow-lg hover:shadow-xl">
            Apply as a Startup
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 lg:py-32 bg-gradient-to-br from-navy-800 to-navy-900 text-white relative z-10">
    <div class="max-w-4xl mx-auto px-4 lg:px-8 text-center">
      <h2 class="font-display text-4xl lg:text-5xl font-bold mb-6">
        Ready to Drive Innovation?
      </h2>
      <p class="text-xl text-sage-200 mb-10">
        Join the platform connecting government challenges with innovative solutions.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/user/submit" class="w-full sm:w-auto px-8 py-4 rounded-lg bg-white text-navy-900 font-bold text-lg hover:bg-gray-100 transition-all shadow-xl">
          Submit a Problem
        </a>
        <a href="/startup/apply" class="w-full sm:w-auto px-8 py-4 rounded-lg bg-gradient-to-r from-sage-500 to-sage-600 text-white font-bold text-lg hover:from-sage-600 hover:to-sage-700 transition-all shadow-xl">
          Join as Startup
        </a>
        <a href="/admin" class="w-full sm:w-auto px-8 py-4 rounded-lg border-2 border-white text-white font-bold text-lg hover:bg-white/10 transition-all">
          Admin Portal
        </a>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
</style>
