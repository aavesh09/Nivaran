          <div class="border-t-2 border-[#dce6f0] pt-4 mt-2">
            <p class="text-xs font-900 text-[#0c1b3a] uppercase tracking-wider mb-3">Record Verified Pilot Result</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
