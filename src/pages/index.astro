---
import Layout from '../layouts/Layout.astro';
import problems_seed from '../data/problems.json';
import applications_seed from '../data/applications.json';
import pilotRuns_seed from '../data/pilotRuns.json';
import scaleDecisions_seed from '../data/scaleDecisions.json';

const categories = ['Sanitation', 'Water', 'Electrical', 'Roads', 'Health', 'Other civic issue'];

const counts = {
  posted:  problems_seed.length,
  matched: problems_seed.filter(p => ['matched','pilot_running','pilot_complete','approved_for_scale','not_approved'].includes(p.status)).length,
  running: problems_seed.filter(p => p.status === 'pilot_running').length,
  decided: problems_seed.filter(p => ['pilot_complete','approved_for_scale','not_approved'].includes(p.status)).length,
};
---

<Layout pageTitle="Dashboard">

  <!-- ══════════════════════ GOV HEADER (NAVY & POWDER BLUE) ══════════════════════ -->
  <div class="ashoka-stripe"></div>

  <header class="bg-[#0c1b3a] text-white shadow-xl border-b border-[#163561] sticky top-0 z-40">
    <div class="max-w-screen-xl mx-auto px-3 sm:px-6 lg:px-8">
      <!-- Top identity bar -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between py-3 sm:py-4 border-b border-[#163561] gap-3 sm:gap-4">
        <!-- Brand -->
        <a href="/" class="flex flex-col leading-none group cursor-pointer">
          <span class="font-display font-900 text-2xl sm:text-4xl tracking-tight text-white group-hover:text-[#d0e6fd] transition-colors">Nivaran</span>
          <span class="text-[10px] sm:text-xs text-[#d0e6fd] font-extrabold tracking-widest uppercase mt-1">National Government Pilot Marketplace</span>
        </a>

        <!-- Role switcher -->
        <div class="flex items-center gap-2 sm:gap-3 bg-[#112650] px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg border border-[#2e5d91] w-full sm:w-auto justify-between sm:justify-start">
          <span class="text-xs text-[#d0e6fd] font-extrabold uppercase tracking-wider shrink-0">Role:</span>
          <select id="role-switcher"
            class="text-xs sm:text-sm font-extrabold bg-[#0c1b3a] border border-[#5680af] text-white rounded px-2.5 py-1.5 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#d0e6fd] hover:border-[#d0e6fd] transition-all flex-1 sm:flex-initial">
            <option value="gov">Government Official</option>
            <option value="startup">Startup Innovator</option>
            <option value="admin">Administrator</option>
          </select>
        </div>
      </div>

      <!-- Tab navigation line — Touch Scrollable -->
      <nav class="flex items-center gap-1 sm:gap-2 overflow-x-auto no-scrollbar py-2 flex-nowrap" id="tab-nav" aria-label="Main navigation">
        {[
          { id: 'overview',    label: 'Overview'            },
          { id: 'gov',         label: 'Government Console'  },
          { id: 'marketplace', label: 'Startup Marketplace' },
          { id: 'command',     label: 'Pilot Command'       },
          { id: 'ledger',      label: 'Proof Ledger'        },
        ].map((tab) => (
          <button
            class="tab-btn px-4 sm:px-6 py-2.5 sm:py-3 text-xs sm:text-base font-extrabold whitespace-nowrap border-b-4 border-transparent text-[#b8cde3] hover:text-white hover:border-[#d0e6fd] cursor-pointer transition-all active:scale-[0.98] shrink-0"
            data-tab={tab.id}
            id={`tab-btn-${tab.id}`}
          >
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
  </header>

  <!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
  <main class="flex-1 max-w-screen-xl mx-auto w-full px-3 sm:px-6 lg:px-8 py-4 sm:py-8">

    <!-- ─── TAB 1: OVERVIEW ─── -->
    <div class="tab-panel active" id="panel-overview">

      <!-- Mission banner -->
      <div class="mb-6 sm:mb-8 bg-[#0c1b3a] text-white rounded-lg p-4 sm:p-6 shadow-md border-l-4 sm:border-l-8 border-[#d0e6fd] flex flex-col sm:flex-row items-start justify-between gap-4 sm:gap-6">
        <div class="flex-1">
          <h1 class="font-display text-xl sm:text-3xl font-900 text-white tracking-tight">Nivaran <span class="text-[#d0e6fd] block sm:inline">— PROOF BEFORE SCALE</span></h1>
          <p class="text-[#dce6f0] text-sm sm:text-base mt-2 leading-relaxed font-medium">
            Official government platform matching public sector civic problems with verified startup solutions.
            Departments establish an empirical baseline. Startups execute time-boxed field pilots.
            Hard data determines full contract scaling.
          </p>
        </div>
        <div class="shrink-0 text-left sm:text-center border-t sm:border-t-0 sm:border-l border-[#1e4478] pt-3 sm:pt-0 sm:pl-6 w-full sm:w-auto cursor-pointer hover:opacity-90 flex sm:flex-col items-center justify-between sm:justify-center" id="banner-stat-btn">
          <div class="text-3xl sm:text-4xl font-display font-900 text-[#d0e6fd] leading-none">{counts.posted}</div>
          <div class="text-[11px] sm:text-xs text-[#b8cde3] font-extrabold uppercase tracking-wider mt-1">Active Problems</div>
        </div>
      </div>

      <!-- 4-stage funnel -->
      <div class="mb-6 sm:mb-8 bg-white border-2 border-[#b8cde3] rounded-lg p-4 sm:p-5 shadow-sm">
        <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
          <p class="text-[11px] sm:text-xs font-900 text-[#0c1b3a] uppercase tracking-widest">Problem Lifecycle Pipeline (Tap stage to filter)</p>
          <button id="reset-funnel-btn" class="text-xs font-bold text-[#1e4478] hover:text-[#0c1b3a] underline cursor-pointer hidden">Clear Filter</button>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4" id="funnel-strip">
          {[
            { key: 'posted',  label: 'Problems Posted',  count: counts.posted,  color: '#0c1b3a', bg: '#e8f3fe' },
            { key: 'matched', label: 'Startups Matched', count: counts.matched, color: '#163561', bg: '#d0e6fd' },
            { key: 'running', label: 'Pilots Running',   count: counts.running, color: '#9a3412', bg: '#ffedd5' },
            { key: 'decided', label: 'Scale Decisions',  count: counts.decided, color: '#14532d', bg: '#dcfce7' },
          ].map((step) => (
            <button
              class="funnel-step text-left rounded-lg p-3 sm:p-4 border-2 transition-all cursor-pointer hover:shadow-md active:scale-[0.98]"
              style={`border-color:${step.color}; background:${step.bg};`}
              data-funnel={step.key}
            >
              <div class="text-2xl sm:text-4xl font-display font-900 leading-none" style={`color:${step.color};`} data-funnel-count={step.key}>{step.count}</div>
              <div class="text-[10px] sm:text-xs font-800 uppercase tracking-wide mt-1.5 sm:mt-2" style={`color:${step.color};`}>{step.label}</div>
            </button>
          ))}
        </div>
      </div>

      <!-- Stat cards — Navy & Powder Blue (#D0E6FD) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 mb-6 sm:mb-8">
        {[
          { label: 'Total Problems',      id: 'stat-total-problems',   value: problems_seed.length,                                                     sub: 'Tap to view all', targetTab: 'overview' },
          { label: 'Applications Filed',  id: 'stat-applications',     value: applications_seed.length,                                                  sub: 'Tap for Marketplace', targetTab: 'marketplace' },
          { label: 'Pilots Running',      id: 'stat-pilots-running',   value: problems_seed.filter(p=>p.status==='pilot_running').length,                sub: 'Tap for Pilot Command', targetTab: 'command' },
          { label: 'Avg. Improvement',    id: 'stat-avg-improvement',  value: '—',                                                                       sub: 'Tap for Proof Ledger', targetTab: 'ledger' },
        ].map((s, i) => (
          <button
            class="stat-click-card bg-white border-2 border-[#b8cde3] rounded-lg p-3.5 sm:p-5 text-left cursor-pointer transition-all hover:border-[#0c1b3a] hover:bg-[#f4f9ff] hover:shadow-lg active:scale-[0.98]"
            data-target-tab={s.targetTab}
          >
            <div class="text-2xl sm:text-3xl font-display font-900 text-[#0c1b3a]" id={s.id}>{s.value}</div>
            <div class="text-xs sm:text-sm font-800 text-[#163561] mt-1 uppercase tracking-wider">{s.label}</div>
            <div class="text-[11px] sm:text-xs text-[#5680af] font-bold mt-1 underline">{s.sub}</div>
          </button>
        ))}
      </div>

      <!-- All problems listing -->
      <div>
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h2 class="font-display text-lg sm:text-xl font-900 text-[#0c1b3a] uppercase tracking-wide">Civic Problems Directory</h2>
          <span class="text-xs font-bold bg-[#0c1b3a] text-[#d0e6fd] px-3 py-1.5 rounded" id="overview-filter-label">ALL PROBLEMS</span>
        </div>
        <div class="space-y-4" id="overview-problem-list">
          <div class="bg-white border-2 border-[#b8cde3] rounded-lg p-6 sm:p-8 text-center text-[#163561] font-bold text-base">Loading datasets…</div>
        </div>
      </div>
    </div>

    <!-- ─── TAB 2: GOV CONSOLE ─── -->
    <div class="tab-panel" id="panel-gov">
      <div class="mb-6">
        <h1 class="font-display text-xl sm:text-3xl font-900 text-[#0c1b3a]">Government Console</h1>
        <p class="text-[#163561] font-bold text-sm sm:text-base mt-1">Post new civic problems with baseline metrics and shortlist startups for time-boxed pilots.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <!-- Form -->
        <div class="bg-white border-2 border-[#b8cde3] rounded-lg p-4 sm:p-6 shadow-sm">
          <h2 class="font-display text-base sm:text-lg font-900 text-[#0c1b3a] mb-4 pb-3 border-b-2 border-[#dce6f0] uppercase tracking-wider">
            Post Problem Specification
          </h2>
          <form id="post-problem-form" class="space-y-4" novalidate>
            <div>
              <label class="block text-sm font-800 text-[#0c1b3a] mb-1">Problem Title <span class="text-red-600">*</span></label>
              <input id="f-title" type="text" required placeholder="e.g. Traffic Light Signal Synchronization"
                class="w-full border-2 border-[#b8cde3] rounded px-3 py-2.5 text-sm font-bold text-[#0c1b3a] focus:outline-none focus:border-[#0c1b3a] focus:ring-2 focus:ring-[#d0e6fd]" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-sm font-800 text-[#0c1b3a] mb-1">Department <span class="text-red-600">*</span></label>
                <input id="f-department" type="text" required placeholder="e.g. Traffic Management Dept."
                  class="w-full border-2 border-[#b8cde3] rounded px-3 py-2.5 text-sm font-bold text-[#0c1b3a] focus:outline-none focus:border-[#0c1b3a]" />
              </div>
              <div>
                <label class="block text-sm font-800 text-[#0c1b3a] mb-1">City / ULB <span class="text-red-600">*</span></label>
                <input id="f-city" type="text" required placeholder="e.g. Bangalore City Corp"
                  class="w-full border-2 border-[#b8cde3] rounded px-3 py-2.5 text-sm font-bold text-[#0c1b3a] focus:outline-none focus:border-[#0c1b3a]" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-800 text-[#0c1b3a] mb-1">Category <span class="text-red-600">*</span></label>
              <select id="f-category"
                class="w-full border-2 border-[#b8cde3] rounded px-3 py-2.5 text-sm font-bold text-[#0c1b3a] focus:outline-none focus:border-[#0c1b3a] cursor-pointer">
                {categories.map(c => <option value={c}>{c}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-sm font-800 text-[#0c1b3a] mb-1">Problem Description <span class="text-red-600">*</span></label>
              <textarea id="f-description" required rows="3"
                placeholder="Detailed explanation of the civic challenge, scope, and impact."
                class="w-full border-2 border-[#b8cde3] rounded px-3 py-2.5 text-sm font-bold text-[#0c1b3a] focus:outline-none focus:border-[#0c1b3a] resize-none"></textarea>
            </div>

            <fieldset class="border-2 border-[#88a9cc] rounded-lg p-3 sm:p-4 bg-[#f4f9ff]">
              <legend class="text-xs font-900 text-[#0c1b3a] uppercase tracking-widest px-2 bg-[#d0e6fd] rounded">Baseline Metric Setup</legend>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-2">
                <div>
                  <label class="block text-xs font-800 text-[#0c1b3a] mb-1">Metric Name <span class="text-red-600">*</span></label>
                  <input id="f-metric-name" type="text" required placeholder="e.g. Uncollected Waste"
                    class="w-full border border-[#5680af] rounded px-2.5 py-2 text-sm font-bold text-[#0c1b3a]" />
                </div>
                <div>
                  <label class="block text-xs font-800 text-[#0c1b3a] mb-1">Unit <span class="text-red-600">*</span></label>
                  <input id="f-metric-unit" type="text" required placeholder="MT/day, %, mins"
                    class="w-full border border-[#5680af] rounded px-2.5 py-2 text-sm font-bold text-[#0c1b3a]" />
                </div>
                <div>
                  <label class="block text-xs font-800 text-[#0c1b3a] mb-1">Baseline Value <span class="text-red-600">*</span></label>
                  <input id="f-baseline" type="number" required placeholder="30"
                    class="w-full border border-[#5680af] rounded px-2.5 py-2 text-sm font-bold text-[#0c1b3a]" />
                </div>
              </div>
              <div class="mt-3">
                <label class="block text-xs font-800 text-[#0c1b3a] mb-1">Target Direction</label>
                <select id="f-direction"
                  class="w-full border border-[#5680af] rounded px-2.5 py-2 text-sm font-bold text-[#0c1b3a] cursor-pointer">
                  <option value="lower_is_better">Lower is better (e.g. reduced wait time, less waste gap)</option>
                  <option value="higher_is_better">Higher is better (e.g. increased recycling MT, coverage %)</option>
                </select>
              </div>
            </fieldset>

            <div id="form-error" class="hidden text-sm font-bold text-red-900 bg-red-100 border-2 border-red-300 rounded px-3 py-2"></div>
            <button type="submit"
              class="w-full bg-[#0c1b3a] hover:bg-[#163561] text-white font-900 py-3 rounded-lg text-sm sm:text-base cursor-pointer transition-all hover:shadow-lg active:scale-[0.99] uppercase tracking-wider">
              Publish Problem to Marketplace
            </button>
          </form>
          <div id="form-success" class="hidden mt-3 text-sm font-bold text-green-950 bg-green-100 border-2 border-green-400 rounded px-3 py-2">
            Problem published successfully and is live on the marketplace.
          </div>
        </div>

        <!-- Dept list -->
        <div>
          <h2 class="font-display text-base sm:text-lg font-900 text-[#0c1b3a] mb-4 uppercase tracking-wider">Manage Posted Problems & Shortlists</h2>
          <div class="space-y-4" id="dept-problem-list">
            <div class="bg-white border-2 border-[#b8cde3] rounded-lg p-6 sm:p-8 text-center text-[#163561] font-bold text-base">Loading department records…</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── TAB 3: STARTUP MARKETPLACE ─── -->
    <div class="tab-panel" id="panel-marketplace">
      <div class="mb-6">
        <h1 class="font-display text-xl sm:text-3xl font-900 text-[#0c1b3a]">Startup Marketplace</h1>
        <p class="text-[#163561] font-bold text-sm sm:text-base mt-1 max-w-3xl">
          Browse open government challenges seeking startup pilot partners. Submit a concise 3-sentence technical pitch to compete for a time-boxed pilot.
        </p>
      </div>
      <div class="space-y-4" id="marketplace-list">
        <div class="bg-white border-2 border-[#b8cde3] rounded-lg p-6 sm:p-8 text-center text-[#163561] font-bold text-base">Loading marketplace challenges…</div>
      </div>
    </div>

    <!-- ─── TAB 4: PILOT COMMAND ─── -->
    <div class="tab-panel" id="panel-command">
      <div class="mb-6">
        <h1 class="font-display text-xl sm:text-3xl font-900 text-[#0c1b3a]">Pilot Command</h1>
        <p class="text-[#163561] font-bold text-sm sm:text-base mt-1">Live monitoring for active field pilots. Record verified after-pilot evaluation numbers when complete.</p>
      </div>
      <div class="space-y-4" id="command-list">
        <div class="bg-white border-2 border-[#b8cde3] rounded-lg p-6 sm:p-8 text-center text-[#163561] font-bold text-base">Loading active pilots…</div>
      </div>
    </div>

    <!-- ─── TAB 5: PROOF LEDGER ─── -->
    <div class="tab-panel" id="panel-ledger">
      <div class="mb-6">
        <h1 class="font-display text-xl sm:text-3xl font-900 text-[#0c1b3a]">Proof Ledger</h1>
        <p class="text-[#163561] font-bold text-sm sm:text-base mt-1">Public accountability record for completed pilots. View before/after comparison metrics and final scaling decisions.</p>
      </div>
      <div class="space-y-4" id="ledger-list">
        <div class="bg-white border-2 border-[#b8cde3] rounded-lg p-6 sm:p-8 text-center text-[#163561] font-bold text-base">Loading audit ledger…</div>
      </div>
    </div>

  </main>

  <!-- ══════════════════════ FOOTER ══════════════════════ -->
  <footer class="bg-[#0c1b3a] text-white text-xs sm:text-sm font-bold py-6 mt-8 sm:mt-12 border-t-2 border-[#163561]">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <span>Nivaran © 2026 — Government Pilot Marketplace · Ministry of Urban Development</span>
      <span class="text-[#d0e6fd] font-extrabold uppercase tracking-wider">Proof Before Scale</span>
    </div>
  </footer>

</Layout>

<script>
import {
  initStore, getStore,
  addProblem, deleteProblem,
  addApplication, shortlistApplication,
  startPilot, recordPilotResult,
  makeScaleDecision, avgImprovement,
} from '../scripts/store.js';

import problemsSeed       from '../data/problems.json';
import applicationsSeed   from '../data/applications.json';
import pilotRunsSeed      from '../data/pilotRuns.json';
import scaleDecisionsSeed from '../data/scaleDecisions.json';

initStore(problemsSeed, applicationsSeed, pilotRunsSeed, scaleDecisionsSeed);

// ── Role ──────────────────────────────────────────────────────────────────────
let currentRole: string = 'gov';
const roleSelect = document.getElementById('role-switcher') as HTMLSelectElement;
roleSelect?.addEventListener('change', () => { currentRole = roleSelect.value; renderAll(); });

// ── Tab switching ─────────────────────────────────────────────────────────────
const tabBtns   = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
let activeTab = 'overview';

function activateTab(id: string) {
  activeTab = id;
  tabBtns.forEach(btn => {
    const on = btn.dataset.tab === id;
    btn.classList.toggle('text-white',          on);
    btn.classList.toggle('border-[#d0e6fd]',    on);
    btn.style.borderBottomColor = on ? '#d0e6fd' : 'transparent';
    btn.classList.toggle('text-[#b8cde3]',      !on);
  });
  tabPanels.forEach(p => p.classList.toggle('active', p.id === `panel-${id}`));
  renderAll();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
tabBtns.forEach(btn => btn.addEventListener('click', () => activateTab(btn.dataset.tab!)));

// ── Status badge ──────────────────────────────────────────────────────────────
const STATUS_MAP: Record<string,[string,string]> = {
  open:              ['OPEN — AWAITING PITCHES',  'background:#f4f9ff;color:#0c1b3a;border:2px solid #5680af;'],
  matched:           ['STARTUP MATCHED',          'background:#d0e6fd;color:#0c1b3a;border:2px solid #163561;'],
  pilot_running:     ['PILOT IN PROGRESS',        'background:#ffedd5;color:#9a3412;border:2px solid #ea580c;'],
  pilot_complete:    ['PILOT COMPLETE',           'background:#fef9c3;color:#854d0e;border:2px solid #ca8a04;'],
  approved_for_scale:['APPROVED FOR SCALE-UP',   'background:#dcfce7;color:#14532d;border:2px solid #16a34a;'],
  not_approved:      ['NOT APPROVED FOR SCALE',   'background:#fee2e2;color:#7f1d1d;border:2px solid #dc2626;'],
};
function badge(status: string) {
  const [label, style] = STATUS_MAP[status] ?? ['UNKNOWN',''];
  return `<span class="status-badge cursor-pointer hover:opacity-80 transition-opacity" data-status="${status}" style="${style}padding:3px 10px;border-radius:4px;font-size:10px;font-weight:900;letter-spacing:0.05em;white-space:nowrap;">${label}</span>`;
}

// ── Clean SVG Category Icon Map (NO EMOJIS) ────────────────────────────────────
function getCategoryIconSvg(category: string): string {
  switch (category) {
    case 'Sanitation':
      return `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#0c1b3a" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>`;
    case 'Water':
      return `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#0c1b3a" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" /></svg>`;
    case 'Electrical':
      return `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#0c1b3a" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>`;
    case 'Roads':
      return `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#0c1b3a" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19L8 5m8 0l4 14M12 5v2m0 4v2m0 4v2" /></svg>`;
    case 'Health':
      return `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#0c1b3a" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>`;
    default:
      return `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#0c1b3a" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h5m-5 0V11m0 0h-2m2 0h2" /></svg>`;
  }
}

// ── Problem Card Renderer — Navy & Powder Blue ─────────────────────────────────
function problemCard(p: any, opts: {del?:boolean,apply?:boolean,shortlist?:boolean} = {}) {
  const canDel = opts.del && (currentRole==='admin'||currentRole==='gov');
  const delBtn = canDel
