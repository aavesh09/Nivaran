       </button>` : '';

  const store = getStore();
  const shortlistSection = (opts.shortlist && p.status==='matched' && (currentRole==='gov'||currentRole==='admin'))
    ? shortlistBlock(p, store) : '';
  const applySection = (opts.apply && p.status==='open' && currentRole==='startup')
    ? applyBlock(p) : '';

  return `
  <div class="problem-card-item bg-white border-2 border-[#b8cde3] rounded-lg p-4 sm:p-6 transition-all hover:border-[#0c1b3a] hover:bg-[#f4f9ff] hover:shadow-lg cursor-pointer" data-problem-id="${p.id}">
