            <strong class="text-[#0c1b3a] font-900 uppercase">Pilot in Progress:</strong> ${pilot.scope_notes} &nbsp;·&nbsp; ${pilot.duration_days} Days
            ${app?` &nbsp;·&nbsp; <strong class="text-[#0c1b3a] font-900">Partner: ${app.startup_name}</strong>`:''}
