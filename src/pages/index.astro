---
import Layout from '../layouts/Layout.astro';
import problems_seed from '../data/problems.json';
import applications_seed from '../data/applications.json';
import pilotRuns_seed from '../data/pilotRuns.json';
import scaleDecisions_seed from '../data/scaleDecisions.json';

const categories = ['Sanitation', 'Water', 'Electrical', 'Roads', 'Health', 'Other civic issue'];

const counts = {
  posted:  problems_seed.length,
  matched: problems_seed.filter(p => ['matched','pilot_running','pilot_complete','approved_for_scale','not_approved'].includes(p.status)).length,
  running: problems_seed.filter(p => p.status === 'pilot_running').length,
  decided: problems_seed.filter(p => ['pilot_complete','approved_for_scale','not_approved'].includes(p.status)).length,
};
---

<Layout pageTitle="Dashboard">

  <!-- ══════════════════════ GOV HEADER ══════════════════════ -->
  <div class="ashoka-stripe"></div>

  <header class="bg-navy-900 text-white shadow-lg">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
      <!-- Top identity bar -->
      <div class="flex items-center justify-between py-3 border-b border-navy-700">
        <!-- Brand — text only, no icon -->
        <a href="/" class="flex flex-col leading-tight">
          <span class="font-display font-900 text-2xl tracking-tight text-white">Nivaran</span>
          <span class="text-xs text-navy-300 font-medium tracking-wide uppercase">Government Pilot Marketplace</span>
        </a>
        <!-- Role switcher -->
        <div class="flex items-center gap-3">
          <span class="text-xs text-navy-300 font-semibold hidden md:block">Viewing as:</span>
          <select id="role-switcher"
            class="text-sm font-semibold bg-navy-800 border border-navy-600 text-white rounded px-3 py-1.5 cursor-pointer focus:outline-none focus:ring-2 focus:ring-saffron-400">
            <option value="gov">🏛️ Government Official</option>
            <option value="startup">🚀 Startup</option>
            <option value="admin">🛡️ Admin</option>
          </select>
        </div>
      </div>

      <!-- Tab navigation -->
      <nav class="flex items-center gap-1 overflow-x-auto py-1" id="tab-nav" aria-label="Main navigation">
        {[
          { id: 'overview',    label: 'Overview'            },
          { id: 'gov',         label: 'Government Console'  },
          { id: 'marketplace', label: 'Startup Marketplace' },
          { id: 'command',     label: 'Pilot Command'       },
          { id: 'ledger',      label: 'Proof Ledger'        },
        ].map((tab) => (
          <button
            class="tab-btn px-4 py-3 text-sm font-semibold whitespace-nowrap border-b-2 border-transparent text-navy-300 hover:text-white hover:border-saffron-400 transition-all"
            data-tab={tab.id}
            id={`tab-btn-${tab.id}`}
          >
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
  </header>

  <!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
  <main class="flex-1 max-w-screen-xl mx-auto w-full px-4 lg:px-6 py-6">

    <!-- ─── TAB 1: OVERVIEW ─── -->
    <div class="tab-panel active" id="panel-overview">

      <!-- Mission banner -->
      <div class="mb-6 bg-navy-900 text-white rounded-md p-5 flex flex-col sm:flex-row items-start gap-4">
        <div class="flex-1">
          <h1 class="font-display text-xl font-800 text-white">Nivaran — <span style="color:#f77f17;">Proof before scale</span></h1>
          <p class="text-navy-200 text-sm mt-1.5 leading-relaxed max-w-2xl">
            A structured marketplace between government departments and startups.
            Departments post real civic problems with a measurable baseline.
            Startups pitch solutions. One startup runs a small, time-boxed pilot.
            Hard data decides who scales — not promises.
          </p>
        </div>
        <div class="shrink-0 text-center hidden sm:block border-l border-navy-700 pl-5">
          <div class="text-3xl font-display font-900 text-saffron-400">{counts.posted}</div>
          <div class="text-xs text-navy-300 font-semibold uppercase tracking-wide mt-0.5">Active problems</div>
        </div>
      </div>

      <!-- 4-stage funnel -->
      <div class="mb-6 bg-white border border-gray-200 rounded-md p-4">
        <p class="text-xs font-700 text-gray-500 uppercase tracking-widest mb-3">Problem Lifecycle</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="funnel-strip">
          {[
            { key: 'posted',  label: 'Problem posted',  count: counts.posted,  color: '#6c757d', bg: '#f8f9fa' },
            { key: 'matched', label: 'Startup matched',  count: counts.matched, color: '#2563eb', bg: '#dbeafe' },
            { key: 'running', label: 'Pilot running',    count: counts.running, color: '#c2410c', bg: '#ffedd5' },
            { key: 'decided', label: 'Scale decision',   count: counts.decided, color: '#16a34a', bg: '#dcfce7' },
          ].map((step) => (
            <button
              class="funnel-step text-left rounded p-3 border-2 transition-all hover:shadow-md"
              style={`border-color:${step.color}20; background:${step.bg};`}
              data-funnel={step.key}
            >
              <div class="text-3xl font-display font-900 leading-none" style={`color:${step.color};`} data-funnel-count={step.key}>{step.count}</div>
              <div class="text-xs font-600 mt-1" style={`color:${step.color};`}>{step.label}</div>
            </button>
          ))}
        </div>
      </div>

      <!-- Stat cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        {[
          { label: 'Total Problems',      id: 'stat-total-problems',   value: problems_seed.length,                                                     sub: 'on platform' },
          { label: 'Applications Filed',  id: 'stat-applications',     value: applications_seed.length,                                                  sub: 'from startups' },
          { label: 'Pilots Running',      id: 'stat-pilots-running',   value: problems_seed.filter(p=>p.status==='pilot_running').length,                sub: 'active pilots' },
          { label: 'Avg. Improvement',    id: 'stat-avg-improvement',  value: '—',                                                                       sub: 'completed pilots' },
        ].map((s, i) => (
          <div class={`bg-white border border-gray-200 rounded-md p-4 animate-slide-up stagger-${i+1}`}>
            <div class="text-2xl font-display font-800 text-navy-900" id={s.id}>{s.value}</div>
            <div class="text-sm font-600 text-gray-700 mt-1">{s.label}</div>
            <div class="text-xs text-gray-400 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>

      <!-- All problems -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <h2 class="font-display text-base font-700 text-navy-900 uppercase tracking-wide">All Problems on Platform</h2>
          <span class="text-xs text-gray-400 font-medium" id="overview-filter-label"></span>
        </div>
        <div class="space-y-3" id="overview-problem-list">
          <div class="bg-white border border-gray-200 rounded-md p-6 text-center text-gray-400 text-sm">Loading…</div>
        </div>
      </div>
    </div>

    <!-- ─── TAB 2: GOV CONSOLE ─── -->
    <div class="tab-panel" id="panel-gov">
      <h1 class="font-display text-xl font-800 text-navy-900 mb-1">Government Console</h1>
      <p class="text-gray-500 text-sm mb-6">Post civic problems for the marketplace. Shortlist startups for pilots.</p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Form -->
        <div class="bg-white border border-gray-200 rounded-md p-6">
          <h2 class="font-display text-base font-700 text-navy-900 mb-4 pb-3 border-b border-gray-100">
            Post a New Problem
          </h2>
          <form id="post-problem-form" class="space-y-4" novalidate>
            <div>
              <label class="block text-sm font-600 text-gray-700 mb-1.5">Problem Title <span class="text-red-500">*</span></label>
              <input id="f-title" type="text" required placeholder="e.g. Missed garbage pickups"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200 placeholder:text-gray-400" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-sm font-600 text-gray-700 mb-1.5">Department <span class="text-red-500">*</span></label>
                <input id="f-department" type="text" required placeholder="e.g. Solid Waste Dept."
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200 placeholder:text-gray-400" />
              </div>
              <div>
                <label class="block text-sm font-600 text-gray-700 mb-1.5">City / ULB <span class="text-red-500">*</span></label>
                <input id="f-city" type="text" required placeholder="e.g. Nagpur MC"
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200 placeholder:text-gray-400" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-600 text-gray-700 mb-1.5">Category <span class="text-red-500">*</span></label>
              <select id="f-category"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200">
                {categories.map(c => <option value={c}>{c}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-sm font-600 text-gray-700 mb-1.5">Problem Description <span class="text-red-500">*</span></label>
              <textarea id="f-description" required rows="3"
                placeholder="Describe the civic problem in detail. Include current situation, impact, and what success looks like."
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200 resize-none placeholder:text-gray-400"></textarea>
            </div>

            <fieldset class="border border-navy-200 rounded p-3 bg-navy-50">
              <legend class="text-xs font-700 text-navy-800 uppercase tracking-wide px-1">Baseline Metric</legend>
              <div class="grid grid-cols-3 gap-2 mt-2">
                <div class="col-span-3 sm:col-span-1">
                  <label class="block text-xs font-600 text-gray-600 mb-1">Metric Name <span class="text-red-500">*</span></label>
                  <input id="f-metric-name" type="text" required placeholder="e.g. Missed pickups"
                    class="w-full border border-gray-300 rounded px-2.5 py-1.5 text-sm focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200 placeholder:text-gray-400" />
                </div>
                <div>
                  <label class="block text-xs font-600 text-gray-600 mb-1">Unit <span class="text-red-500">*</span></label>
                  <input id="f-metric-unit" type="text" required placeholder="%, hrs, days"
                    class="w-full border border-gray-300 rounded px-2.5 py-1.5 text-sm focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200 placeholder:text-gray-400" />
                </div>
                <div>
                  <label class="block text-xs font-600 text-gray-600 mb-1">Baseline Value <span class="text-red-500">*</span></label>
                  <input id="f-baseline" type="number" required placeholder="e.g. 40"
                    class="w-full border border-gray-300 rounded px-2.5 py-1.5 text-sm focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200 placeholder:text-gray-400" />
                </div>
              </div>
              <div class="mt-2">
                <label class="block text-xs font-600 text-gray-600 mb-1">Improvement Direction</label>
                <select id="f-direction"
                  class="w-full border border-gray-300 rounded px-2.5 py-1.5 text-sm focus:outline-none focus:border-navy-600 focus:ring-2 focus:ring-navy-200">
                  <option value="lower_is_better">Lower is better (e.g. fewer incidents, less time)</option>
                  <option value="higher_is_better">Higher is better (e.g. coverage %, satisfaction)</option>
                </select>
              </div>
            </fieldset>

            <div id="form-error" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded px-3 py-2"></div>
            <button type="submit"
              class="w-full bg-navy-800 hover:bg-navy-900 text-white font-700 py-2.5 rounded text-sm transition-colors flex items-center justify-center gap-2">
              + Post Problem to Marketplace
            </button>
          </form>
          <div id="form-success" class="hidden mt-3 text-sm text-green-800 bg-green-50 border border-green-200 rounded px-3 py-2">
            ✅ Problem posted successfully and is now live on the marketplace.
          </div>
        </div>

        <!-- Dept list -->
        <div>
          <h2 class="font-display text-base font-700 text-navy-900 mb-4">Posted by Your Department</h2>
          <div class="space-y-3" id="dept-problem-list">
            <div class="bg-white border border-gray-200 rounded-md p-6 text-center text-gray-400 text-sm">Loading…</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── TAB 3: STARTUP MARKETPLACE ─── -->
    <div class="tab-panel" id="panel-marketplace">
      <div class="mb-6">
        <h1 class="font-display text-xl font-800 text-navy-900">Startup Marketplace</h1>
        <p class="text-gray-600 text-sm mt-1 leading-relaxed max-w-2xl">
          Open problems seeking a pilot partner. Apply with a short pitch — the department shortlists
          one startup for a small, time-boxed pilot. Not a full contract. Proof first.
        </p>
      </div>
      <div class="space-y-4" id="marketplace-list">
        <div class="bg-white border border-gray-200 rounded-md p-6 text-center text-gray-400 text-sm">Loading…</div>
      </div>
    </div>

    <!-- ─── TAB 4: PILOT COMMAND ─── -->
    <div class="tab-panel" id="panel-command">
      <div class="mb-6">
        <h1 class="font-display text-xl font-800 text-navy-900">Pilot Command</h1>
        <p class="text-gray-600 text-sm mt-1">Active pilots — monitor progress and record results when the pilot period ends.</p>
      </div>
      <div class="space-y-4" id="command-list">
        <div class="bg-white border border-gray-200 rounded-md p-6 text-center text-gray-400 text-sm">Loading…</div>
      </div>
    </div>

    <!-- ─── TAB 5: PROOF LEDGER ─── -->
    <div class="tab-panel" id="panel-ledger">
      <div class="mb-6">
        <h1 class="font-display text-xl font-800 text-navy-900">Proof Ledger</h1>
        <p class="text-gray-600 text-sm mt-1">Completed pilots — all decisions and results recorded here for accountability.</p>
      </div>
      <div class="space-y-4" id="ledger-list">
        <div class="bg-white border border-gray-200 rounded-md p-6 text-center text-gray-400 text-sm">Loading…</div>
      </div>
    </div>

  </main>

  <footer class="bg-navy-900 text-navy-300 text-xs py-4 mt-6">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <span>Nivaran © 2026 — Government Pilot Marketplace · Ministry of Urban Development</span>
      <span class="text-navy-400">Built for accountability · Proof before scale</span>
    </div>
  </footer>

</Layout>

<script>
import {
  initStore, getStore,
  addProblem, deleteProblem,
  addApplication, shortlistApplication,
  startPilot, recordPilotResult,
  makeScaleDecision, avgImprovement,
} from '../scripts/store.js';

import problemsSeed       from '../data/problems.json';
import applicationsSeed   from '../data/applications.json';
import pilotRunsSeed      from '../data/pilotRuns.json';
import scaleDecisionsSeed from '../data/scaleDecisions.json';

initStore(problemsSeed, applicationsSeed, pilotRunsSeed, scaleDecisionsSeed);

// ── Role ──────────────────────────────────────────────────────────────────────
let currentRole: string = 'gov';
const roleSelect = document.getElementById('role-switcher') as HTMLSelectElement;
roleSelect?.addEventListener('change', () => { currentRole = roleSelect.value; renderAll(); });

// ── Tab switching ─────────────────────────────────────────────────────────────
const tabBtns   = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
let activeTab = 'overview';

function activateTab(id: string) {
  activeTab = id;
  tabBtns.forEach(btn => {
    const on = btn.dataset.tab === id;
    btn.classList.toggle('text-white',          on);
    btn.classList.toggle('border-saffron-400',  on);
    btn.style.borderBottomColor = on ? '#f77f17' : '';
    btn.classList.toggle('text-navy-300',       !on);
    btn.classList.toggle('border-transparent',  !on);
  });
  tabPanels.forEach(p => p.classList.toggle('active', p.id === `panel-${id}`));
  renderAll();
}
tabBtns.forEach(btn => btn.addEventListener('click', () => activateTab(btn.dataset.tab!)));

// ── Status badge ──────────────────────────────────────────────────────────────
const STATUS_MAP: Record<string,[string,string]> = {
  open:              ['Open — Awaiting startups', 'background:#f1f3f5;color:#495057;border:1px solid #ced4da;'],
  matched:           ['Startup Matched',          'background:#dbeafe;color:#1e40af;border:1px solid #bfdbfe;'],
  pilot_running:     ['Pilot Running',            'background:#ffedd5;color:#c2410c;border:1px solid #fed7aa;'],
  pilot_complete:    ['Pilot Complete',           'background:#fef9c3;color:#a16207;border:1px solid #fde68a;'],
  approved_for_scale:['Approved for Scale',       'background:#dcfce7;color:#166534;border:1px solid #bbf7d0;'],
  not_approved:      ['Not Approved',             'background:#fee2e2;color:#991b1b;border:1px solid #fecaca;'],
};
function badge(status: string) {
  const [label, style] = STATUS_MAP[status] ?? ['Unknown',''];
  return `<span style="${style}padding:2px 10px;border-radius:3px;font-size:12px;font-weight:600;white-space:nowrap;">${label}</span>`;
}

// ── Category icon ─────────────────────────────────────────────────────────────
const CAT_ICON: Record<string,string> = {
  Sanitation:'🗑️', Water:'💧', Electrical:'⚡', Roads:'🛣️', Health:'🏥', 'Other civic issue':'🏙️'
};

// ── Problem card ──────────────────────────────────────────────────────────────
function problemCard(p: any, opts: {del?:boolean,apply?:boolean,shortlist?:boolean} = {}) {
  const canDel = opts.del && (currentRole==='admin'||currentRole==='gov');
  const delBtn = canDel
    ? `<button class="delete-problem-btn text-gray-400 hover:text-red-600 transition-colors" data-id="${p.id}" title="Delete problem" style="padding:4px;">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.021-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
       </button>` : '';

  const store = getStore();
  const shortlistSection = (opts.shortlist && p.status==='matched' && (currentRole==='gov'||currentRole==='admin'))
    ? shortlistBlock(p, store) : '';
  const applySection = (opts.apply && p.status==='open' && currentRole==='startup')
    ? applyBlock(p) : '';

  return `
  <div class="bg-white border border-gray-200 rounded-md p-4 transition-all hover:border-navy-400 hover:shadow-sm" data-problem-id="${p.id}">
    <div class="flex items-start gap-3">
      <div style="font-size:22px;width:36px;text-align:center;padding-top:2px;">${CAT_ICON[p.category]??'📋'}</div>
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2 flex-wrap mb-1.5">
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#0c1b3a;margin:0;">${p.title}</h3>
          <div class="flex items-center gap-2 shrink-0">${badge(p.status)}${delBtn}</div>
        </div>
        <p style="font-size:12px;color:#6c757d;font-weight:600;margin:0 0 6px 0;">${p.department} &nbsp;·&nbsp; ${p.city_ulb} &nbsp;·&nbsp; ${p.category}</p>
        <p style="font-size:14px;color:#343a40;margin:0 0 10px 0;line-height:1.6;">${p.description}</p>
        <div style="display:inline-flex;align-items:center;gap:6px;background:#f0f4f8;border:1px solid #b8cde3;border-radius:4px;padding:4px 10px;font-size:12px;font-weight:600;color:#163561;">
          Baseline metric: <strong>${p.metric_name}</strong> = ${p.baseline_value}${p.metric_unit}
          &nbsp;<span style="color:#6c757d;">(${p.metric_direction==='lower_is_better'?'lower is better':'higher is better'})</span>
        </div>
        ${applySection}${shortlistSection}
      </div>
    </div>
  </div>`;
}

function applyBlock(p: any) {
  return `
  <div style="margin-top:12px;padding-top:12px;border-top:1px solid #dee2e6;">
    <p style="font-size:12px;font-weight:700;color:#343a40;margin:0 0 8px 0;text-transform:uppercase;letter-spacing:0.05em;">Apply with a Solution</p>
    <input type="text" id="apply-name-${p.id}" placeholder="Your startup / organisation name"
      style="width:100%;border:1.5px solid #ced4da;border-radius:4px;padding:8px 10px;font-size:13px;color:#212529;margin-bottom:8px;box-sizing:border-box;" />
    <textarea id="apply-pitch-${p.id}" placeholder="Describe your approach in 3–5 sentences. What will you do and why will it work?" rows="2"
      style="width:100%;border:1.5px solid #ced4da;border-radius:4px;padding:8px 10px;font-size:13px;color:#212529;resize:none;box-sizing:border-box;"></textarea>
    <button class="apply-submit-btn" data-pid="${p.id}"
      style="margin-top:8px;width:100%;background:#f77f17;color:#fff;font-weight:700;font-size:13px;padding:9px;border:none;border-radius:4px;cursor:pointer;">
      Submit Application →
    </button>
    <div id="apply-msg-${p.id}" style="display:none;margin-top:6px;font-size:13px;color:#166534;background:#dcfce7;border:1px solid #bbf7d0;border-radius:4px;padding:6px 10px;">Application submitted successfully.</div>
  </div>`;
}

function shortlistBlock(p: any, store: any) {
  const apps = store.applications.filter((a: any) => a.problem_id === p.id);
  if (!apps.length) return `<div style="margin-top:10px;font-size:12px;color:#6c757d;">No applications yet.</div>`;
  return `
  <div style="margin-top:12px;padding-top:12px;border-top:1px solid #dee2e6;">
    <p style="font-size:12px;font-weight:700;color:#343a40;margin:0 0 8px 0;text-transform:uppercase;letter-spacing:0.05em;">Applications (${apps.length})</p>
    ${apps.map((a: any) => `
      <div style="background:#f8f9fa;border:1px solid #dee2e6;border-radius:4px;padding:10px;margin-bottom:8px;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
          <span style="font-weight:700;font-size:13px;color:#0c1b3a;">${a.startup_name}</span>
          ${a.status==='shortlisted'
            ? `<span style="font-size:11px;background:#dbeafe;color:#1e40af;border:1px solid #bfdbfe;border-radius:3px;padding:2px 8px;font-weight:600;">Shortlisted</span>`
            : `<button class="shortlist-btn" data-aid="${a.id}" data-pid="${p.id}"
                style="font-size:12px;background:#1e4478;color:#fff;border:none;border-radius:4px;padding:4px 12px;cursor:pointer;font-weight:600;">
                Shortlist &amp; Start Pilot →
               </button>`}
        </div>
        <p style="font-size:13px;color:#495057;margin:6px 0 0 0;line-height:1.5;">${a.pitch}</p>
      </div>`).join('')}
  </div>`;
}

// ── SVG bar chart ─────────────────────────────────────────────────────────────
function barChart(p: any, pilot: any) {
  const b = p.baseline_value, a = pilot.after_value, u = p.metric_unit;
  const maxV = Math.max(b, a) * 1.25;
  const H = 90, bW = 48, gap = 36, pL = 10, pB = 24;
  const toY = (v: number) => H - pB - ((v/maxV)*(H-pB-10));
  const bH = H-pB-toY(b), aH = H-pB-toY(a);
  const aX = pL+bW+gap;
  let impPct: number, better: boolean;
  if (p.metric_direction==='lower_is_better') { impPct=Math.round(((b-a)/b)*100); better=impPct>0; }
  else { impPct=Math.round(((a-b)/b)*100); better=impPct>0; }
  const impColor = better ? '#16a34a' : '#dc2626';
  const W = pL+bW+gap+bW+pL;
  return `
  <svg viewBox="0 0 ${W} ${H+20}" width="${W}" height="${H+20}" xmlns="http://www.w3.org/2000/svg">
    <text x="${W/2}" y="11" text-anchor="middle" font-size="11" font-weight="700" fill="${impColor}">${better?'▲':'▼'} ${Math.abs(impPct)}% ${better?'improvement':'regression'}</text>
    <rect x="${pL}" y="${toY(b)+14}" width="${bW}" height="${bH}" rx="3" fill="#94a3b8"/>
    <text x="${pL+bW/2}" y="${toY(b)+12}" text-anchor="middle" font-size="11" font-weight="600" fill="#334155">${b}${u}</text>
    <text x="${pL+bW/2}" y="${H+16}" text-anchor="middle" font-size="10" fill="#6c757d">Before</text>
    <rect x="${aX}" y="${toY(a)+14}" width="${bW}" height="${aH}" rx="3" fill="${better?'#16a34a':'#dc2626'}"/>
    <text x="${aX+bW/2}" y="${toY(a)+12}" text-anchor="middle" font-size="11" font-weight="600" fill="${better?'#14532d':'#7f1d1d'}">${a}${u}</text>
    <text x="${aX+bW/2}" y="${H+16}" text-anchor="middle" font-size="10" fill="#6c757d">After</text>
  </svg>`;
}

// ── RENDERERS ─────────────────────────────────────────────────────────────────
let funnelFilter: string|undefined;

function renderOverview() {
  const store = getStore();
  const probs = store.problems as any[];
  const fMap: Record<string,string[]> = {
    posted:  ['open','matched','pilot_running','pilot_complete','approved_for_scale','not_approved'],
    matched: ['matched','pilot_running','pilot_complete','approved_for_scale','not_approved'],
    running: ['pilot_running'],
    decided: ['pilot_complete','approved_for_scale','not_approved'],
  };
  ['posted','matched','running','decided'].forEach(k=>{
    const el=document.querySelector(`[data-funnel-count="${k}"]`);
    if(el) el.textContent=String(probs.filter(p=>fMap[k].includes(p.status)).length);
  });
  const s = (id: string, v: string|number) => { const el=document.getElementById(id); if(el) el.textContent=String(v); };
  s('stat-total-problems', probs.length);
  s('stat-applications', store.applications.length);
  s('stat-pilots-running', probs.filter((p:any)=>p.status==='pilot_running').length);
  const avg = avgImprovement(store);
  s('stat-avg-improvement', avg!==null ? `${avg}%` : '—');
  const lbl = document.getElementById('overview-filter-label');
  if(lbl) lbl.textContent = funnelFilter ? `Showing: ${funnelFilter.replace('_',' ')}` : '';
  let filtered = funnelFilter ? probs.filter(p=>fMap[funnelFilter!].includes(p.status)) : probs;
  const c = document.getElementById('overview-problem-list')!;
  c.innerHTML = filtered.length
    ? filtered.map(p=>problemCard(p,{del:true})).join('')
    : `<div style="background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:40px;text-align:center;color:#6c757d;font-size:14px;">No problems match this filter.</div>`;
  attachDelete(c); attachShortlist(c);
}

function renderGov() {
  const store = getStore();
  const probs = store.problems as any[];
  const c = document.getElementById('dept-problem-list')!;
  c.innerHTML = probs.length
    ? probs.map(p=>problemCard(p,{del:true,shortlist:true})).join('')
    : `<div style="background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:40px;text-align:center;color:#6c757d;font-size:14px;">No problems posted yet. Use the form to post your first problem.</div>`;
  attachDelete(c); attachShortlist(c);
}

function renderMarketplace() {
  const store = getStore();
  const probs = (store.problems as any[]).filter(p=>p.status==='open'||p.status==='matched');
  const c = document.getElementById('marketplace-list')!;
  c.innerHTML = probs.length
    ? probs.map(p=>problemCard(p,{apply:true})).join('')
    : `<div style="background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:40px;text-align:center;color:#6c757d;font-size:14px;">No open problems at this time.</div>`;
  attachApply(c);
}

function renderCommand() {
  const store = getStore();
  const probs = (store.problems as any[]).filter(p=>p.status==='pilot_running');
  const canRec = currentRole==='gov'||currentRole==='admin';
  const c = document.getElementById('command-list')!;
  if(!probs.length){
    c.innerHTML=`<div style="background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:40px;text-align:center;color:#6c757d;font-size:14px;">No pilots currently running.</div>`;
    return;
  }
  c.innerHTML = probs.map(p=>{
    const pilot = store.pilotRuns.find((r:any)=>r.problem_id===p.id&&r.status==='running');
    const app   = pilot ? store.applications.find((a:any)=>a.id===pilot.application_id) : null;
    return `
    <div style="background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:20px;" data-problem-id="${p.id}">
      <div style="display:flex;align-items:start;gap:12px;">
        <div style="font-size:22px;width:36px;text-align:center;padding-top:2px;">${CAT_ICON[p.category]??'📋'}</div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:start;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:4px;">
            <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#0c1b3a;margin:0;">${p.title}</h3>
            ${badge(p.status)}
          </div>
          <p style="font-size:12px;color:#6c757d;font-weight:600;margin:0 0 8px 0;">${p.department} · ${p.city_ulb}</p>
          <p style="font-size:14px;color:#343a40;margin:0 0 10px 0;line-height:1.6;">${p.description}</p>
          ${pilot?`<div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:4px;padding:8px 12px;font-size:13px;margin-bottom:10px;">
            <strong style="color:#c2410c;">Pilot in progress:</strong>
            <span style="color:#9a3412;"> ${pilot.scope_notes} &nbsp;·&nbsp; ${pilot.duration_days} days</span>
            ${app?`&nbsp;·&nbsp;<strong style="color:#9a3412;">Partner: ${app.startup_name}</strong>`:''}
          </div>`:''}
          <div style="display:inline-flex;align-items:center;gap:6px;background:#f0f4f8;border:1px solid #b8cde3;border-radius:4px;padding:4px 10px;font-size:12px;font-weight:600;color:#163561;margin-bottom:${canRec?'16px':'0'};">
            Baseline: <strong>${p.metric_name}</strong> = ${p.baseline_value}${p.metric_unit}
          </div>
          ${canRec?`
          <div style="border-top:1px solid #dee2e6;padding-top:14px;">
            <p style="font-size:12px;font-weight:700;color:#343a40;margin:0 0 10px 0;text-transform:uppercase;letter-spacing:0.05em;">Record Pilot Result</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
              <div>
                <label style="display:block;font-size:12px;font-weight:600;color:#495057;margin-bottom:4px;">After-pilot value *</label>
                <input type="number" id="after-val-${p.id}" placeholder="Was ${p.baseline_value}${p.metric_unit}"
                  style="width:100%;border:1.5px solid #ced4da;border-radius:4px;padding:7px 10px;font-size:13px;box-sizing:border-box;" />
              </div>
              <div>
                <label style="display:block;font-size:12px;font-weight:600;color:#495057;margin-bottom:4px;">Field notes</label>
                <input type="text" id="field-notes-${p.id}" placeholder="Observations from the field"
                  style="width:100%;border:1.5px solid #ced4da;border-radius:4px;padding:7px 10px;font-size:13px;box-sizing:border-box;" />
              </div>
            </div>
            <button class="record-result-btn" data-pid="${p.id}"
              style="width:100%;background:#1e4478;color:#fff;font-weight:700;font-size:13px;padding:10px;border:none;border-radius:4px;cursor:pointer;">
              Record Pilot Result →
            </button>
            <div id="record-msg-${p.id}" style="display:none;margin-top:8px;font-size:13px;color:#166534;background:#dcfce7;border:1px solid #bbf7d0;border-radius:4px;padding:7px 10px;">
              Result recorded. Problem moved to Proof Ledger.
            </div>
          </div>`:''}
        </div>
      </div>
    </div>`;
  }).join('');

  c.querySelectorAll<HTMLButtonElement>('.record-result-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const pid=btn.dataset.pid!;
      const av=(document.getElementById(`after-val-${pid}`) as HTMLInputElement)?.value.trim();
      if(!av){ alert('Please enter the after-pilot value.'); return; }
      const fn=(document.getElementById(`field-notes-${pid}`) as HTMLInputElement)?.value??'';
      recordPilotResult(pid, Number(av), fn);
      const msg=document.getElementById(`record-msg-${pid}`);
      if(msg) msg.style.display='block';
      setTimeout(()=>renderAll(), 700);
    });
  });
}

function renderLedger() {
  const store = getStore();
  const probs = (store.problems as any[]).filter(p=>['pilot_complete','approved_for_scale','not_approved'].includes(p.status));
  const canDec = currentRole==='gov'||currentRole==='admin';
  const c = document.getElementById('ledger-list')!;
  if(!probs.length){
    c.innerHTML=`<div style="background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:40px;text-align:center;color:#6c757d;font-size:14px;">No completed pilots yet. Results will appear here once pilots are concluded.</div>`;
    return;
  }
  c.innerHTML = probs.map(p=>{
    const pilot=store.pilotRuns.find((r:any)=>r.problem_id===p.id&&r.status==='complete');
    const dec=store.scaleDecisions.find((d:any)=>d.problem_id===p.id);
    const chart=pilot&&pilot.after_value!==null ? barChart(p,pilot) : '';
    const decBlock=dec?`
      <div style="margin-top:12px;padding:10px 14px;border-radius:4px;${dec.decision==='approved_for_scale'?'background:#dcfce7;border:1px solid #bbf7d0;':'background:#fee2e2;border:1px solid #fecaca;'}">
        <p style="font-size:13px;font-weight:700;margin:0;color:${dec.decision==='approved_for_scale'?'#166534':'#991b1b'};">${dec.decision==='approved_for_scale'?'✅ Approved for Scale-Up':'❌ Not Approved for Scale'}</p>
        ${dec.notes?`<p style="font-size:12px;color:#495057;margin:4px 0 0 0;">${dec.notes}</p>`:''}
      </div>`:
      (canDec&&p.status==='pilot_complete'?`
      <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
        <button class="scale-decision-btn" data-pid="${p.id}" data-decision="approved_for_scale"
          style="flex:1;min-width:160px;background:#138808;color:#fff;font-weight:700;font-size:13px;padding:9px 16px;border:none;border-radius:4px;cursor:pointer;">
          ✅ Approve for Scale-Up
        </button>
        <button class="scale-decision-btn" data-pid="${p.id}" data-decision="not_approved"
          style="flex:1;min-width:120px;background:#fff;color:#991b1b;font-weight:700;font-size:13px;padding:9px 16px;border:1.5px solid #fca5a5;border-radius:4px;cursor:pointer;">
          ❌ Not Approved
        </button>
      </div>
      <div id="ledger-msg-${p.id}" style="display:none;margin-top:8px;font-size:13px;color:#166534;background:#dcfce7;border:1px solid #bbf7d0;border-radius:4px;padding:7px 10px;">Decision recorded.</div>
      `:'');
    return `
    <div style="background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:20px;" data-problem-id="${p.id}">
      <div style="display:flex;align-items:start;gap:12px;">
        <div style="font-size:22px;width:36px;text-align:center;padding-top:2px;">${CAT_ICON[p.category]??'📋'}</div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:start;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:4px;">
            <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#0c1b3a;margin:0;">${p.title}</h3>
            ${badge(p.status)}
          </div>
          <p style="font-size:12px;color:#6c757d;font-weight:600;margin:0 0 8px 0;">${p.department} · ${p.city_ulb}</p>
          <p style="font-size:14px;color:#343a40;margin:0 0 10px 0;line-height:1.6;">${p.description}</p>
          <div style="display:inline-flex;align-items:center;gap:6px;background:#f0f4f8;border:1px solid #b8cde3;border-radius:4px;padding:4px 10px;font-size:12px;font-weight:600;color:#163561;">
            Baseline: <strong>${p.metric_name}</strong> = ${p.baseline_value}${p.metric_unit}
          </div>
          ${chart?`<div style="margin-top:12px;">${chart}</div>`:''}
          ${pilot?.field_notes?`<p style="margin-top:8px;font-size:13px;color:#495057;font-style:italic;">Field note: "${pilot.field_notes}"</p>`:''}
          ${decBlock}
        </div>
      </div>
    </div>`;
  }).join('');

  c.querySelectorAll<HTMLButtonElement>('.scale-decision-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const pid=btn.dataset.pid!, dec=btn.dataset.decision!;
      makeScaleDecision(pid,dec,'');
      const msg=document.getElementById(`ledger-msg-${pid}`);
      if(msg) msg.style.display='block';
      setTimeout(()=>renderAll(),600);
    });
  });
}

// ── Listener helpers ──────────────────────────────────────────────────────────
function attachDelete(c: HTMLElement) {
  c.querySelectorAll<HTMLButtonElement>('.delete-problem-btn').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.stopPropagation();
      if(confirm('Delete this problem and all related data?')){ deleteProblem(btn.dataset.id!); renderAll(); }
    });
  });
}
function attachApply(c: HTMLElement) {
  c.querySelectorAll<HTMLButtonElement>('.apply-submit-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const pid=btn.dataset.pid!;
      const n=(document.getElementById(`apply-name-${pid}`) as HTMLInputElement)?.value.trim();
      const pitch=(document.getElementById(`apply-pitch-${pid}`) as HTMLTextAreaElement)?.value.trim();
      if(!n||!pitch){ alert('Please fill in both your name and pitch.'); return; }
      addApplication(pid,n,pitch);
      const msg=document.getElementById(`apply-msg-${pid}`);
      if(msg) msg.style.display='block';
      btn.disabled=true; btn.textContent='Application Submitted';
      setTimeout(()=>renderAll(),800);
    });
  });
}
function attachShortlist(c: HTMLElement) {
  c.querySelectorAll<HTMLButtonElement>('.shortlist-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const aid=btn.dataset.aid!, pid=btn.dataset.pid!;
      shortlistApplication(aid);
      const scope=prompt('Enter pilot scope notes (e.g. "6 tankers, 2 wards"):')?? 'To be defined';
      const days=parseInt(prompt('Pilot duration in days (e.g. 21):')?? '21',10)||21;
      startPilot(pid,aid,scope,days);
      renderAll();
    });
  });
}

// ── Funnel filter ─────────────────────────────────────────────────────────────
document.querySelectorAll<HTMLButtonElement>('[data-funnel]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const k=btn.dataset.funnel!;
    funnelFilter = funnelFilter===k ? undefined : k;
    if(activeTab!=='overview') activateTab('overview');
    else renderOverview();
  });
});

// ── Form submit ───────────────────────────────────────────────────────────────
document.getElementById('post-problem-form')?.addEventListener('submit',e=>{
  e.preventDefault();
  const g=(id:string)=>(document.getElementById(id) as HTMLInputElement)?.value?.trim();
  const title=g('f-title'),dept=g('f-department'),city=g('f-city'),desc=g('f-description'),metric=g('f-metric-name'),unit=g('f-metric-unit');
  const baseline=parseFloat(g('f-baseline')||'');
  const err=document.getElementById('form-error')!;
  if(!title||!dept||!city||!desc||!metric||!unit||isNaN(baseline)){
    err.textContent='Please fill in all required fields marked with *.'; err.style.display='block'; return;
  }
  err.style.display='none';
  addProblem({
    title, department:dept, city_ulb:city,
    category:(document.getElementById('f-category') as HTMLSelectElement)?.value??'Other civic issue',
    description:desc, metric_name:metric, metric_unit:unit,
    metric_direction:(document.getElementById('f-direction') as HTMLSelectElement)?.value??'lower_is_better',
    baseline_value:baseline, posted_by:'current-user',
  });
  (document.getElementById('post-problem-form') as HTMLFormElement).reset();
  const ok=document.getElementById('form-success')!; ok.style.display='block';
  setTimeout(()=>{ ok.style.display='none'; },3500);
  renderAll();
});

// ── Master render + init ──────────────────────────────────────────────────────
function renderAll() {
  renderOverview(); renderGov(); renderMarketplace(); renderCommand(); renderLedger();
}
activateTab('overview');
</script>
