function shortlistBlock(p: any, store: any) {
  const apps = store.applications.filter((a: any) => a.problem_id === p.id);
  if (!apps.length) return `<div class="mt-3 text-xs font-bold text-[#5680af]">No applications received yet.</div>`;
  return `
  <div class="mt-4 pt-4 border-t-2 border-[#dce6f0]">
    <p class="text-xs font-900 text-[#0c1b3a] uppercase tracking-wider mb-2">Startup Applications (${apps.length})</p>
    ${apps.map((a: any) => `
      <div class="bg-[#f4f9ff] border-2 border-[#b8cde3] rounded-lg p-3 mb-2">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <span class="font-extrabold text-sm text-[#0c1b3a]">${a.startup_name}</span>
          ${a.status==='shortlisted'
            ? `<span class="text-xs font-900 bg-[#d0e6fd] text-[#0c1b3a] border border-[#163561] px-3 py-1 rounded">SHORTLISTED</span>`
            : `<button class="shortlist-btn text-xs bg-[#0c1b3a] hover:bg-[#163561] text-white font-900 px-4 py-2 rounded cursor-pointer transition-all" data-aid="${a.id}" data-pid="${p.id}">
                Shortlist &amp; Start Pilot →
               </button>`}
        </div>
        <p class="text-xs font-bold text-[#163561] mt-2 leading-relaxed">${a.pitch}</p>
      </div>`).join('')}
  </div>`;
}

// ── SVG Bar Chart for Proof Ledger ─────────────────────────────────────────────
function barChart(p: any, pilot: any) {
  const b = p.baseline_value, a = pilot.after_value, u = p.metric_unit;
  const maxV = Math.max(b, a) * 1.25;
  const H = 100, bW = 54, gap = 40, pL = 20, pB = 26;
  const toY = (v: number) => H - pB - ((v/maxV)*(H-pB-12));
  const bH = H-pB-toY(b), aH = H-pB-toY(a);
  const aX = pL+bW+gap;
  let impPct: number, better: boolean;
  if (p.metric_direction==='lower_is_better') { impPct=Math.round(((b-a)/b)*100); better=impPct>0; }
  else { impPct=Math.round(((a-b)/b)*100); better=impPct>0; }
  const impColor = better ? '#15803d' : '#b91c1c';
  const W = pL+bW+gap+bW+pL;
  return `
  <div class="bg-[#f4f9ff] border-2 border-[#b8cde3] rounded-lg p-3 sm:p-4 my-3 overflow-x-auto max-w-full no-scrollbar inline-block">
    <svg viewBox="0 0 ${W} ${H+20}" width="${W}" height="${H+20}" class="max-w-[280px] sm:max-w-[340px] h-auto" xmlns="http://www.w3.org/2000/svg">
      <text x="${W/2}" y="12" text-anchor="middle" font-size="12" font-weight="900" fill="${impColor}">${Math.abs(impPct)}% ${better?'IMPROVEMENT':'REGRESSION'}</text>
      <rect x="${pL}" y="${toY(b)+14}" width="${bW}" height="${bH}" rx="4" fill="#5680af"/>
      <text x="${pL+bW/2}" y="${toY(b)+10}" text-anchor="middle" font-size="12" font-weight="900" fill="#0c1b3a">${b}${u}</text>
      <text x="${pL+bW/2}" y="${H+16}" text-anchor="middle" font-size="11" font-weight="800" fill="#163561">BEFORE</text>
      <rect x="${aX}" y="${toY(a)+14}" width="${bW}" height="${aH}" rx="4" fill="${better?'#16a34a':'#dc2626'}"/>
      <text x="${aX+bW/2}" y="${toY(a)+10}" text-anchor="middle" font-size="12" font-weight="900" fill="${better?'#14532d':'#7f1d1d'}">${a}${u}</text>
      <text x="${aX+bW/2}" y="${H+16}" text-anchor="middle" font-size="11" font-weight="800" fill="#163561">AFTER</text>
    </svg>
  </div>`;
}

// ── RENDERERS ─────────────────────────────────────────────────────────────────
let funnelFilter: string|undefined;

function renderOverview() {
  const store = getStore();
  const probs = store.problems as any[];
  const fMap: Record<string,string[]> = {
    posted:  ['open','matched','pilot_running','pilot_complete','approved_for_scale','not_approved'],
    matched: ['matched','pilot_running','pilot_complete','approved_for_scale','not_approved'],
    running: ['pilot_running'],
    decided: ['pilot_complete','approved_for_scale','not_approved'],
  };
  ['posted','matched','running','decided'].forEach(k=>{
    const el=document.querySelector(`[data-funnel-count="${k}"]`);
    if(el) el.textContent=String(probs.filter(p=>fMap[k].includes(p.status)).length);
  });
  const s = (id: string, v: string|number) => { const el=document.getElementById(id); if(el) el.textContent=String(v); };
  s('stat-total-problems', probs.length);
  s('stat-applications', store.applications.length);
  s('stat-pilots-running', probs.filter((p:any)=>p.status==='pilot_running').length);
  const avg = avgImprovement(store);
  s('stat-avg-improvement', avg!==null ? `${avg}%` : '—');

  const lbl = document.getElementById('overview-filter-label');
  const clearBtn = document.getElementById('reset-funnel-btn');
  if(lbl) lbl.textContent = funnelFilter ? `FILTERED: ${funnelFilter.toUpperCase()}` : 'ALL PROBLEMS';
  if(clearBtn) clearBtn.classList.toggle('hidden', !funnelFilter);

  let filtered = funnelFilter ? probs.filter(p=>fMap[funnelFilter!].includes(p.status)) : probs;
  const c = document.getElementById('overview-problem-list')!;
  c.innerHTML = filtered.length
    ? filtered.map(p=>problemCard(p,{del:true})).join('')
    : `<div class="bg-white border-2 border-[#b8cde3] rounded-lg p-6 sm:p-10 text-center text-[#163561] font-bold text-base">No problems match this filter criteria.</div>`;
  attachDelete(c); attachShortlist(c); attachCardClicks(c);
}

function renderGov() {
  const store = getStore();
  const probs = store.problems as any[];
  const c = document.getElementById('dept-problem-list')!;
  c.innerHTML = probs.length
