        <p class="text-[11px] sm:text-xs font-800 text-[#163561] uppercase tracking-wider mb-2">${p.department} &nbsp;·&nbsp; ${p.city_ulb} &nbsp;·&nbsp; ${p.category}</p>
        <p class="text-sm sm:text-base font-bold text-[#0c1b3a] mb-3 sm:mb-4 leading-relaxed">${p.description}</p>

        <!-- Metric Highlight Box (Powder Blue #D0E6FD) -->
        <div class="metric-highlight">
          <span>BASELINE METRIC:</span>
          <span class="text-[#0c1b3a] font-extrabold">${p.metric_name}</span> = <span class="text-[#0c1b3a] font-extrabold text-sm sm:text-base">${p.baseline_value} ${p.metric_unit}</span>
          <span class="text-[#163561] font-bold">(${p.metric_direction==='lower_is_better'?'Lower is better':'Higher is better'})</span>
        </div>

        ${applySection}${shortlistSection}
      </div>
    </div>
  </div>`;
}

function applyBlock(p: any) {
  return `
