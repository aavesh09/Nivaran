    <p class="text-xs font-900 text-[#0c1b3a] uppercase tracking-wider mb-2">Submit Startup Pilot Pitch</p>
    <input type="text" id="apply-name-${p.id}" placeholder="Your Startup / Organisation Name *"
      class="w-full border-2 border-[#b8cde3] rounded px-3 py-2.5 text-sm font-bold text-[#0c1b3a] mb-2 focus:outline-none focus:border-[#0c1b3a]" />
    <textarea id="apply-pitch-${p.id}" placeholder="Describe your technical solution in 3–5 sentences. Why will it improve the baseline metric? *" rows="2"
      class="w-full border-2 border-[#b8cde3] rounded px-3 py-2.5 text-sm font-bold text-[#0c1b3a] resize-none focus:outline-none focus:border-[#0c1b3a]"></textarea>
    <button class="apply-submit-btn w-full mt-2 bg-[#0c1b3a] hover:bg-[#163561] text-white font-900 text-sm py-3 rounded cursor-pointer transition-all uppercase tracking-wider" data-pid="${p.id}">
