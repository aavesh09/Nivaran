function renderLedger() {
  const store = getStore();
  const probs = (store.problems as any[]).filter(p=>['pilot_complete','approved_for_scale','not_approved'].includes(p.status));
  const canDec = currentRole==='gov'||currentRole==='admin';
  const c = document.getElementById('ledger-list')!;
  if(!probs.length){
    c.innerHTML=`<div class="bg-white border-2 border-[#b8cde3] rounded-lg p-6 sm:p-10 text-center text-[#163561] font-bold text-base">No completed pilots in the ledger yet. Results appear here once pilots conclude.</div>`;
    return;
  }
  c.innerHTML = probs.map(p=>{
    const pilot=store.pilotRuns.find((r:any)=>r.problem_id===p.id&&r.status==='complete');
    const dec=store.scaleDecisions.find((d:any)=>d.problem_id===p.id);
    const chart=pilot&&pilot.after_value!==null ? barChart(p,pilot) : '';
    const decBlock=dec?`
      <div class="mt-4 p-4 rounded-lg font-bold border-2 ${dec.decision==='approved_for_scale'?'bg-green-100 border-green-500 text-green-950':'bg-red-100 border-red-500 text-red-950'}">
        <p class="text-sm font-900 uppercase tracking-wider">${dec.decision==='approved_for_scale'?'Approved for Scale-Up':'Not Approved for Scale'}</p>
        ${dec.notes?`<p class="text-xs font-bold mt-1 text-[#163561]">${dec.notes}</p>`:''}
      </div>`:
      (canDec&&p.status==='pilot_complete'?`
      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <button class="scale-decision-btn flex-1 bg-green-700 hover:bg-green-800 text-white font-900 text-sm py-3 rounded cursor-pointer transition-all uppercase tracking-wider" data-pid="${p.id}" data-decision="approved_for_scale">
          Approve for Scale-Up
        </button>
        <button class="scale-decision-btn flex-1 bg-white border-2 border-red-500 text-red-700 hover:bg-red-50 font-900 text-sm py-3 rounded cursor-pointer transition-all uppercase tracking-wider" data-pid="${p.id}" data-decision="not_approved">
          Not Approved
        </button>
      </div>
      <div id="ledger-msg-${p.id}" class="hidden mt-2 text-sm font-bold text-green-950 bg-green-100 border-2 border-green-400 rounded px-3 py-2">Decision recorded.</div>
      `:'');
    return `
    <div class="problem-card-item bg-white border-2 border-[#b8cde3] rounded-lg p-4 sm:p-6 transition-all hover:border-[#0c1b3a] hover:bg-[#f4f9ff] cursor-pointer" data-problem-id="${p.id}">
      <div class="flex flex-col sm:flex-row items-start gap-3 sm:gap-4">
        <div class="shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-lg bg-[#d0e6fd] border-2 border-[#163561] flex items-center justify-center">
          ${getCategoryIconSvg(p.category)}
        </div>
        <div class="flex-1 min-w-0 w-full">
          <div class="flex items-start justify-between gap-2 flex-wrap mb-1.5">
            <h3 class="font-display font-900 text-base sm:text-lg text-[#0c1b3a]">${p.title}</h3>
            ${badge(p.status)}
          </div>
          <p class="text-[11px] sm:text-xs font-800 text-[#163561] uppercase tracking-wider mb-2">${p.department} · ${p.city_ulb}</p>
          <p class="text-sm sm:text-base font-bold text-[#0c1b3a] mb-3 sm:mb-4 leading-relaxed">${p.description}</p>
          <div class="metric-highlight">
            <span>BASELINE:</span> <strong>${p.metric_name}</strong> = ${p.baseline_value} ${p.metric_unit}
          </div>
          ${chart?`<div>${chart}</div>`:''}
          ${pilot?.field_notes?`<p class="mt-2 text-xs sm:text-sm font-bold text-[#163561] italic">Field Note: "${pilot.field_notes}"</p>`:''}
          ${decBlock}
        </div>
      </div>
    </div>`;
  }).join('');

  c.querySelectorAll<HTMLButtonElement>('.scale-decision-btn').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.stopPropagation();
      const pid=btn.dataset.pid!, dec=btn.dataset.decision!;
      makeScaleDecision(pid,dec,'');
      const msg=document.getElementById(`ledger-msg-${pid}`);
      if(msg) msg.style.display='block';
      setTimeout(()=>renderAll(),600);
    });
  });
  attachCardClicks(c);
}

// ── Listener helpers ──────────────────────────────────────────────────────────
function attachDelete(c: HTMLElement) {
  c.querySelectorAll<HTMLButtonElement>('.delete-problem-btn').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.stopPropagation();
      if(confirm('Delete this problem and all related data?')){ deleteProblem(btn.dataset.id!); renderAll(); }
    });
  });
}

function attachApply(c: HTMLElement) {
  c.querySelectorAll<HTMLButtonElement>('.apply-submit-btn').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.stopPropagation();
      const pid=btn.dataset.pid!;
      const n=(document.getElementById(`apply-name-${pid}`) as HTMLInputElement)?.value.trim();
      const pitch=(document.getElementById(`apply-pitch-${pid}`) as HTMLTextAreaElement)?.value.trim();
      if(!n||!pitch){ alert('Please fill in both your startup name and pitch.'); return; }
      addApplication(pid,n,pitch);
      const msg=document.getElementById(`apply-msg-${pid}`);
      if(msg) msg.style.display='block';
      btn.disabled=true; btn.textContent='Application Submitted';
      setTimeout(()=>renderAll(),800);
    });
  });
}

function attachShortlist(c: HTMLElement) {
  c.querySelectorAll<HTMLButtonElement>('.shortlist-btn').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.stopPropagation();
      const aid=btn.dataset.aid!, pid=btn.dataset.pid!;
      shortlistApplication(aid);
      const scope=prompt('Enter pilot scope notes (e.g. "25 signals on Outer Ring Road corridor"):')?? 'To be defined';
      const days=parseInt(prompt('Pilot duration in days (e.g. 30):')?? '30',10)||30;
      startPilot(pid,aid,scope,days);
      renderAll();
    });
  });
}

function attachCardClicks(c: HTMLElement) {
  c.querySelectorAll<HTMLElement>('.problem-card-item').forEach(card => {
    card.addEventListener('click', (e) => {
      // Don't trigger card click if user clicked an interactive input or button inside
      const target = e.target as HTMLElement;
      if (target.closest('button, input, textarea, select, a, .delete-problem-btn')) return;
      card.classList.toggle('ring-4');
      card.classList.toggle('ring-[#0c1b3a]');
    });
  });
}

// ── Funnel filter & Stat card clicks ──────────────────────────────────────────
document.querySelectorAll<HTMLButtonElement>('[data-funnel]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const k=btn.dataset.funnel!;
    funnelFilter = funnelFilter===k ? undefined : k;
    if(activeTab!=='overview') activateTab('overview');
    else renderOverview();
  });
});

document.getElementById('reset-funnel-btn')?.addEventListener('click', () => {
  funnelFilter = undefined;
  renderOverview();
});

document.getElementById('banner-stat-btn')?.addEventListener('click', () => {
  funnelFilter = undefined;
  activateTab('overview');
});

document.querySelectorAll<HTMLButtonElement>('.stat-click-card').forEach(btn => {
  btn.addEventListener('click', () => {
    const targetTab = btn.dataset.targetTab;
    if (targetTab) activateTab(targetTab);
  });
});

// ── Form submit ───────────────────────────────────────────────────────────────
document.getElementById('post-problem-form')?.addEventListener('submit',e=>{
  e.preventDefault();
  const g=(id:string)=>(document.getElementById(id) as HTMLInputElement)?.value?.trim();
  const title=g('f-title'),dept=g('f-department'),city=g('f-city'),desc=g('f-description'),metric=g('f-metric-name'),unit=g('f-metric-unit');
  const baseline=parseFloat(g('f-baseline')||'');
  const err=document.getElementById('form-error')!;
  if(!title||!dept||!city||!desc||!metric||!unit||isNaN(baseline)){
    err.textContent='Please fill in all required fields marked with *.'; err.style.display='block'; return;
  }
  err.style.display='none';
  addProblem({
    title, department:dept, city_ulb:city,
    category:(document.getElementById('f-category') as HTMLSelectElement)?.value??'Other civic issue',
    description:desc, metric_name:metric, metric_unit:unit,
    metric_direction:(document.getElementById('f-direction') as HTMLSelectElement)?.value??'lower_is_better',
    baseline_value:baseline, posted_by:'current-user',
  });
  (document.getElementById('post-problem-form') as HTMLFormElement).reset();
  const ok=document.getElementById('form-success')!; ok.style.display='block';
  setTimeout(()=>{ ok.style.display='none'; },3500);
  renderAll();
});

// ── Master render + init ──────────────────────────────────────────────────────
function renderAll() {
  renderOverview(); renderGov(); renderMarketplace(); renderCommand(); renderLedger();
}
activateTab('overview');
</script>
