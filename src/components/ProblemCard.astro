---
import Badge from './Badge.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  department: string;
  domain: string;
  urgency: string;
  budget: number;
  status: string;
  submittedAt: string;
}

const { id, title, description, department, domain, urgency, budget, status, submittedAt } = Astro.props;

const urgencyVariant = {
  critical: 'danger',
  high: 'warning',
  medium: 'info',
  low: 'neutral',
} as const;

const statusVariant = {
  open: 'accent',
  matched: 'info',
  'pilot-active': 'success',
  'pilot-completed': 'neutral',
} as const;

const domainIcons: Record<string, string> = {
  traffic: '🚦',
  waste: '♻️',
  water: '💧',
  safety: '🛡️',
  energy: '⚡',
  digital: '💻',
  environment: '🌿',
};

const formatBudget = (b: number) =>
  b >= 1000 ? `$${(b / 1000).toFixed(0)}K` : `$${b}`;

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<a href={`/problems/${id}`} class="block">
  <div class="glass glass-hover p-5 space-y-4 group cursor-pointer">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="text-2xl">{domainIcons[domain] || '📋'}</span>
        <div>
          <h3 class="font-display font-bold text-text-primary group-hover:text-teal-400 transition-colors line-clamp-1">
            {title}
          </h3>
          <p class="text-xs text-text-muted mt-0.5">{department}</p>
        </div>
      </div>
    </div>

    <p class="text-sm text-text-secondary line-clamp-2">{description}</p>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 flex-wrap">
        <Badge variant={urgencyVariant[urgency as keyof typeof urgencyVariant] || 'neutral'}>{urgency}</Badge>
        <Badge variant={statusVariant[status as keyof typeof statusVariant] || 'neutral'}>{status.replace('-', ' ')}</Badge>
      </div>
      <div class="flex items-center gap-3 text-xs text-text-muted">
        <span>{formatBudget(budget)}</span>
        <span>{formatDate(submittedAt)}</span>
      </div>
    </div>
  </div>
</a>
