---
interface Props {
  title: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { title, breadcrumbs = [] } = Astro.props;
---

<header class="sticky top-0 z-20 backdrop-blur-xl bg-navy-950/80 border-b border-white/[0.06]">
  <div class="flex items-center justify-between h-16 px-6">
    <div class="flex items-center gap-4">
      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg hover:bg-white/[0.04] text-text-secondary"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-sm">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && (
              <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            )}
            {crumb.href ? (
              <a href={crumb.href} class="text-text-secondary hover:text-teal-400 transition-colors">
                {crumb.label}
              </a>
            ) : (
              <span class="text-text-primary font-medium">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <!-- Search (placeholder) -->
      <div class="hidden md:flex items-center gap-2 px-3 py-2 rounded-xl bg-white/[0.04] border border-white/[0.06] text-text-muted text-sm w-64 cursor-text">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <span>Search...</span>
        <span class="ml-auto text-xs bg-white/[0.06] px-1.5 py-0.5 rounded text-text-muted">⌘K</span>
      </div>

      <!-- Notification bell -->
      <button class="relative p-2 rounded-xl hover:bg-white/[0.04] text-text-secondary transition-colors" aria-label="Notifications">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
        </svg>
        <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-teal-400 animate-pulse" />
      </button>
    </div>
  </div>
</header>
