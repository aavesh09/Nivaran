---
interface Props {
  title: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { title, breadcrumbs = [] } = Astro.props;
---

<header class="sticky top-0 z-20 backdrop-blur-xl bg-white/98 border-b-2 border-navy-300 shadow-lg">
  <div class="flex items-center justify-between h-16 px-4 lg:px-6">
    <div class="flex items-center gap-4">
      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2.5 rounded-lg hover:bg-sage-100 text-navy-800 transition-colors border-2 border-transparent hover:border-sage-300"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && (
              <svg class="w-4 h-4 text-navy-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            )}
            {crumb.href ? (
              <a href={crumb.href} class="text-navy-600 hover:text-sage-600 transition-colors font-bold text-sm">
                {crumb.label}
              </a>
            ) : (
              <span class="text-navy-900 font-bold text-lg">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <!-- Search -->
      <div class="hidden md:flex items-center relative">
        <div class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-gray-100 border-2 border-navy-300 text-navy-800 text-sm w-72 cursor-text transition-all focus-within:border-sage-500 focus-within:ring-2 focus-within:ring-sage-400/40" id="search-container">
          <svg class="w-5 h-5 shrink-0 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <input type="text" id="search-input" placeholder="Search..." class="bg-transparent border-none outline-none text-navy-900 placeholder-navy-500 text-sm w-full font-medium" autocomplete="off" />
          <span class="ml-auto text-xs bg-white border-2 border-navy-400 px-2 py-1 rounded text-navy-800 shrink-0 font-bold">⌘K</span>
        </div>
        <!-- Search Results Dropdown -->
        <div id="search-results" class="absolute top-full left-0 right-0 mt-2 bg-white border-2 border-navy-300 rounded-lg shadow-2xl p-2 space-y-1 hidden z-50 max-h-80 overflow-y-auto">
        </div>
      </div>

      <!-- Notification bell -->
      <div class="relative" id="notification-wrapper">
        <button class="relative p-2.5 rounded-lg hover:bg-sage-100 text-navy-800 transition-colors border-2 border-transparent hover:border-sage-300" aria-label="Notifications" id="notification-btn">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
          </svg>
          <span class="absolute top-2 right-2 w-2.5 h-2.5 rounded-full bg-sage-600 animate-pulse ring-2 ring-white shadow-md" id="notification-dot" />
        </button>
        <!-- Notification dropdown -->
        <div id="notification-dropdown" class="absolute right-0 top-full mt-2 w-80 bg-white border-2 border-navy-300 rounded-lg shadow-2xl p-0 hidden z-50">
          <div class="px-4 py-3 border-b-2 border-navy-200 bg-navy-50">
            <div class="flex items-center justify-between">
              <h3 class="font-display font-bold text-base text-navy-900">Notifications</h3>
              <button id="mark-all-read" class="text-sm text-sage-700 hover:text-sage-800 transition-colors font-bold">Mark all read</button>
            </div>
          </div>
          <div class="max-h-64 overflow-y-auto" id="notification-list">
            <div class="px-4 py-3 border-b border-navy-200 hover:bg-sage-50 transition-colors cursor-pointer">
              <div class="flex items-start gap-3">
                <span class="text-xl mt-0.5">🚀</span>
                <div>
                  <p class="text-sm text-navy-900 font-bold">Traffic pilot updated</p>
                  <p class="text-xs text-navy-700 mt-0.5 font-medium">Signal Optimization KPI reached 55%</p>
                  <p class="text-xs text-navy-500 mt-1 font-medium">2 hours ago</p>
                </div>
              </div>
            </div>
            <div class="px-4 py-3 border-b border-navy-200 hover:bg-sage-50 transition-colors cursor-pointer">
              <div class="flex items-start gap-3">
                <span class="text-xl mt-0.5">💧</span>
                <div>
                  <p class="text-sm text-navy-900 font-bold">Water Quality KPI hit 72%</p>
                  <p class="text-xs text-navy-700 mt-0.5 font-medium">Monitoring coverage target on track</p>
                  <p class="text-xs text-navy-500 mt-1 font-medium">5 hours ago</p>
                </div>
              </div>
            </div>
            <div class="px-4 py-3 border-b border-navy-200 hover:bg-sage-50 transition-colors cursor-pointer">
              <div class="flex items-start gap-3">
                <span class="text-xl mt-0.5">✅</span>
                <div>
                  <p class="text-sm text-navy-900 font-bold">Air Quality pilot scaled</p>
                  <p class="text-xs text-navy-700 mt-0.5 font-medium">ClearSky Sensors approved for deployment</p>
                  <p class="text-xs text-navy-500 mt-1 font-medium">1 day ago</p>
                </div>
              </div>
            </div>
            <div class="px-4 py-3 hover:bg-sage-50 transition-colors cursor-pointer">
              <div class="flex items-start gap-3">
                <span class="text-xl mt-0.5">📋</span>
                <div>
                  <p class="text-sm text-navy-900 font-bold">New problem submitted</p>
                  <p class="text-xs text-navy-700 mt-0.5 font-medium">Stormwater Management System needs review</p>
                  <p class="text-xs text-navy-500 mt-1 font-medium">2 days ago</p>
                </div>
              </div>
            </div>
          </div>
          <div class="px-4 py-3 border-t-2 border-navy-200 text-center bg-gray-50">
            <a href="/reports" class="text-sm text-sage-700 hover:text-sage-800 transition-colors font-bold">View all activity →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // ─── Search Functionality ───
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results');

  // Navigation items for search
  const searchableItems = [
    { title: 'Dashboard', description: 'Overview and stats', href: '/', icon: '📊' },
    { title: 'Problems', description: 'View all problems', href: '/problems', icon: '📋' },
    { title: 'Submit Problem', description: 'Submit a new problem', href: '/problems/new', icon: '➕' },
    { title: 'Startups', description: 'Startup directory', href: '/startups', icon: '🚀' },
    { title: 'Startup Matching', description: 'Match startups to problems', href: '/startups/match', icon: '🔍' },
    { title: 'Pilots', description: 'Active & completed pilots', href: '/pilots', icon: '📈' },
    { title: 'Launch Pilot', description: 'Create a new pilot', href: '/pilots/new', icon: '🎯' },
    { title: 'Reports', description: 'Pilot outcome reports', href: '/reports', icon: '📊' },
  ];

  if (searchInput && searchResults) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      if (!q) {
        searchResults.classList.add('hidden');
        return;
      }

      const filtered = searchableItems.filter(item =>
        item.title.toLowerCase().includes(q) || item.description.toLowerCase().includes(q)
      ).slice(0, 8);

      if (filtered.length === 0) {
        searchResults.innerHTML = '<div class="px-3 py-4 text-sm text-navy-600 text-center font-medium">No results found</div>';
      } else {
        searchResults.innerHTML = filtered.map(item => `
          <a href="${item.href}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-sage-100 transition-colors group border-2 border-transparent hover:border-sage-300">
            <span class="text-xl">${item.icon}</span>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-navy-900 font-bold group-hover:text-sage-700 transition-colors truncate">${item.title}</p>
              <p class="text-xs text-navy-700 truncate font-medium">${item.description}</p>
            </div>
            <svg class="w-4 h-4 text-navy-500 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        `).join('');
      }
      searchResults.classList.remove('hidden');
    });

    searchInput.addEventListener('blur', () => {
      setTimeout(() => searchResults.classList.add('hidden'), 200);
    });

    searchInput.addEventListener('focus', () => {
      if (searchInput.value.trim()) {
        searchInput.dispatchEvent(new Event('input'));
      }
    });

    // Cmd+K / Ctrl+K shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput.focus();
      }
      if (e.key === 'Escape') {
        searchInput.blur();
        searchResults.classList.add('hidden');
      }
    });
  }

  // ─── Notification Dropdown ───
  const notifBtn = document.getElementById('notification-btn');
  const notifDropdown = document.getElementById('notification-dropdown');
  const notifDot = document.getElementById('notification-dot');
  const markAllRead = document.getElementById('mark-all-read');

  if (notifBtn && notifDropdown) {
    notifBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      notifDropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!notifDropdown.contains(e.target as Node) && !notifBtn.contains(e.target as Node)) {
        notifDropdown.classList.add('hidden');
      }
    });
  }

  if (markAllRead && notifDot) {
    markAllRead.addEventListener('click', () => {
      notifDot.classList.add('hidden');
      const items = document.querySelectorAll('#notification-list > div');
      items.forEach(item => {
        (item as HTMLElement).style.opacity = '0.5';
      });
    });
  }
</script>
