---
interface Props {
  currentPath: string;
  transparent?: boolean;
}

const { currentPath, transparent = false } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/success-stories', label: 'Success Stories' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${transparent ? 'bg-transparent' : 'bg-white/95 backdrop-blur-xl border-b-2 border-navy-200 shadow-md'}`} id="main-nav">
  <div class="max-w-7xl mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-sage-500 to-sage-600 flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all group-hover:scale-105">
          <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0v-6m3-3H9" />
          </svg>
        </div>
        <div>
          <span class="font-display font-bold text-xl text-navy-900">GovPilot</span>
          <p class="text-xs text-navy-600 font-semibold">Innovation Platform</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-bold transition-colors relative py-2 ${
              isActive(item.href)
                ? 'text-sage-700'
                : 'text-navy-700 hover:text-sage-600'
            }`}
          >
            {item.label}
            {isActive(item.href) && (
              <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-sage-600 rounded-full" />
            )}
          </a>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="/user/submit" class="px-5 py-2.5 rounded-lg border-2 border-navy-300 text-navy-800 font-bold text-sm hover:bg-navy-50 hover:border-navy-400 transition-all">
          Submit Problem
        </a>
        <a href="/startup/apply" class="px-5 py-2.5 rounded-lg bg-gradient-to-r from-sage-500 to-sage-600 text-white font-bold text-sm hover:from-sage-600 hover:to-sage-700 transition-all shadow-md hover:shadow-lg">
          For Startups
        </a>
        <a href="/admin" class="px-5 py-2.5 rounded-lg bg-navy-700 text-white font-bold text-sm hover:bg-navy-800 transition-all">
          Admin Login
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-nav-btn" class="lg:hidden p-2 rounded-lg hover:bg-navy-100 text-navy-800 transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t-2 border-navy-200 bg-white">
    <div class="px-4 py-4 space-y-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-4 py-3 rounded-lg font-bold text-sm transition-all ${
            isActive(item.href)
              ? 'bg-sage-100 text-sage-700'
              : 'text-navy-700 hover:bg-navy-50'
          }`}
        >
          {item.label}
        </a>
      ))}
      <div class="pt-3 border-t-2 border-navy-200 space-y-2">
        <a href="/user/submit" class="block px-4 py-3 rounded-lg border-2 border-navy-300 text-navy-800 font-bold text-sm text-center hover:bg-navy-50">
          Submit Problem
        </a>
        <a href="/startup/apply" class="block px-4 py-3 rounded-lg bg-gradient-to-r from-sage-500 to-sage-600 text-white font-bold text-sm text-center shadow-md">
          For Startups
        </a>
        <a href="/admin" class="block px-4 py-3 rounded-lg bg-navy-700 text-white font-bold text-sm text-center">
          Admin Login
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const mobileBtn = document.getElementById('mobile-nav-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mainNav = document.getElementById('main-nav');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Handle scroll for transparent nav
  if (mainNav) {
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;

      if (currentScroll > 50) {
        mainNav.classList.remove('bg-transparent');
        mainNav.classList.add('bg-white/95', 'backdrop-blur-xl', 'border-b-2', 'border-navy-200', 'shadow-md');
      } else if (mainNav.dataset.transparent === 'true') {
        mainNav.classList.add('bg-transparent');
        mainNav.classList.remove('bg-white/95', 'backdrop-blur-xl', 'border-b-2', 'border-navy-200', 'shadow-md');
      }

      lastScroll = currentScroll;
    });
  }
</script>
