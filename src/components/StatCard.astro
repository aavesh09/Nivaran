---
interface Props {
  label: string;
  value: string | number;
  trend?: string;
  trendUp?: boolean;
  icon?: string;
  delay?: number;
  clickable?: boolean;
}

const { label, value, trend, trendUp, icon = '📊', delay = 0, clickable = false } = Astro.props;
---

<div
  class={`glass p-5 lg:p-6 flex flex-col gap-3 animate-slide-up opacity-0 border-2 border-navy-200 ${
    clickable ? 'cursor-pointer hover:border-sage-400 hover:shadow-lg hover:scale-[1.02] transition-all duration-300 group' : ''
  }`}
  style={`animation-delay: ${delay}ms; animation-fill-mode: forwards;`}
>
  <div class="flex items-center justify-between">
    <span class="text-3xl lg:text-4xl transform group-hover:scale-110 transition-transform">{icon}</span>
    {trend && (
      <span class={`inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full ${
        trendUp ? 'bg-sage-100 text-sage-700' : 'bg-red-100 text-red-700'
      }`}>
        <svg class={`w-3.5 h-3.5 ${trendUp ? '' : 'rotate-180'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
        {trend}
      </span>
    )}
  </div>
  <div class="font-display text-3xl lg:text-4xl font-bold text-navy-900 tracking-tight group-hover:text-sage-700 transition-colors">{value}</div>
  <div class="text-sm font-semibold text-navy-700 group-hover:text-navy-800 transition-colors">{label}</div>
  {clickable && (
    <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
      <svg class="w-5 h-5 text-sage-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </div>
  )}
</div>
