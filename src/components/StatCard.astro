---
interface Props {
  label: string;
  value: string | number;
  trend?: string;
  trendUp?: boolean;
  icon?: string;
  delay?: number;
}

const { label, value, trend, trendUp, icon = '📊', delay = 0 } = Astro.props;
---

<div
  class="glass glass-hover p-6 flex flex-col gap-3 animate-slide-up opacity-0"
  style={`animation-delay: ${delay}ms; animation-fill-mode: forwards;`}
>
  <div class="flex items-center justify-between">
    <span class="text-2xl">{icon}</span>
    {trend && (
      <span class={`inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-full ${
        trendUp ? 'bg-emerald-500/15 text-emerald-400' : 'bg-red-500/15 text-red-400'
      }`}>
        <svg class={`w-3 h-3 ${trendUp ? '' : 'rotate-180'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
        {trend}
      </span>
    )}
  </div>
  <div class="font-display text-3xl font-bold text-text-primary tracking-tight">{value}</div>
  <div class="text-sm text-text-secondary">{label}</div>
</div>
