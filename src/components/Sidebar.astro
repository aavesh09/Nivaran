---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: '/', label: 'Dashboard', icon: 'dashboard' },
  { href: '/problems', label: 'Problems', icon: 'problems' },
  { href: '/startups', label: 'Startups', icon: 'startups' },
  { href: '/pilots', label: 'Pilots', icon: 'pilots' },
  { href: '/reports', label: 'Reports', icon: 'reports' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<aside class="fixed left-0 top-0 bottom-0 w-64 bg-white border-r-2 border-navy-300 z-40 flex flex-col transition-transform duration-300 lg:translate-x-0 -translate-x-full shadow-xl" id="sidebar">
  <!-- Logo / Brand -->
  <div class="p-5 border-b-2 border-navy-300 bg-gradient-to-br from-navy-700 to-navy-600">
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-11 h-11 rounded-lg bg-sage-500 flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all group-hover:scale-105 border-2 border-white">
        <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0v-6m3-3H9" />
        </svg>
      </div>
      <div>
        <span class="font-display font-bold text-xl text-white tracking-tight">GovPilot</span>
        <p class="text-xs text-sage-200 tracking-wide uppercase font-bold">Platform</p>
      </div>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto bg-gray-50">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`flex items-center gap-3 px-4 py-3.5 rounded-lg text-base font-bold transition-all duration-200 group relative
          ${isActive(item.href)
            ? 'bg-gradient-to-r from-sage-500 to-sage-600 text-white shadow-lg scale-[1.02]'
            : 'text-navy-800 hover:text-navy-900 hover:bg-sage-100 hover:shadow-md border-2 border-transparent hover:border-sage-300'
          }`}
      >
        <span class={`w-6 h-6 flex items-center justify-center ${isActive(item.href) ? 'text-white' : 'text-sage-600 group-hover:text-sage-700'}`}>
          {item.icon === 'dashboard' && (
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zm0 7a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1h-4a1 1 0 01-1-1v-5zM4 13a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1v-5z" />
            </svg>
          )}
          {item.icon === 'problems' && (
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          )}
          {item.icon === 'startups' && (
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
            </svg>
          )}
          {item.icon === 'pilots' && (
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
            </svg>
          )}
          {item.icon === 'reports' && (
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          )}
        </span>
        <span class="truncate">{item.label}</span>
        {isActive(item.href) && (
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-12 bg-white rounded-l-full shadow-lg" />
        )}
      </a>
    ))}
  </nav>

  <!-- Bottom section -->
  <div class="p-4 border-t-2 border-navy-300 bg-gray-50">
    <div class="p-3 rounded-lg bg-white border-2 border-navy-300 flex items-center gap-3 shadow-md hover:shadow-lg transition-shadow">
      <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-navy-700 to-navy-600 flex items-center justify-center text-sm font-bold text-white shadow-md border-2 border-navy-300">
        AD
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-bold text-navy-900 truncate">Admin User</p>
        <p class="text-xs text-navy-700 truncate font-semibold">admin@gov.in</p>
      </div>
    </div>
  </div>
</aside>

<!-- Mobile overlay -->
<div id="sidebar-overlay" class="fixed inset-0 bg-navy-900/70 backdrop-blur-sm z-30 hidden lg:hidden" />
