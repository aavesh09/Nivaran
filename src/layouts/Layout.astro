---
import '../styles/global.css';

interface Props {
  title?: string;
  pageTitle?: string;
}

const { title = 'PilotSetu', pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="PilotSetu — Proof before scale. A marketplace between government departments and startups." />
    <meta name="title" content="PilotSetu — Proof before scale" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <title>{pageTitle ? `${pageTitle} — PilotSetu` : 'PilotSetu — Proof before scale'}</title>
  </head>
  <body>
    <!-- Background blobs -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col">
      <slot />
    </div>
  </body>
</html>
