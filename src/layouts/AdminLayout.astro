---
import TopBar from '../components/TopBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  pageTitle?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { title = 'Nivaran Admin', pageTitle, breadcrumbs = [] } = Astro.props;

const currentPath = Astro.url.pathname;

const adminNavItems = [
  { href: '/admin', label: 'Dashboard', icon: '📊' },
  { href: '/admin/problems', label: 'Problems', icon: '📋' },
  { href: '/admin/startups', label: 'Startups', icon: '🚀' },
  { href: '/admin/pilots', label: 'Pilots', icon: '📈' },
  { href: '/admin/reports', label: 'Reports', icon: '📊' },
];

const isActive = (href: string) => {
  if (href === '/admin') return currentPath === '/admin';
  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Nivaran — Government Pilot Marketplace" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <title>{pageTitle ? `${pageTitle} — ${title}` : title}</title>

    <script is:inline>
      document.documentElement.classList.remove('dark');
    </script>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <!-- Navy & Powder Blue Background Pattern -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-navy-200/30 blur-3xl" />
      <div class="absolute top-1/2 -left-40 w-96 h-96 rounded-full bg-sage-300/40 blur-3xl" />
      <div class="absolute -bottom-40 right-1/3 w-96 h-96 rounded-full bg-sage-200/35 blur-3xl" />
    </div>

    <!-- Top Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/98 backdrop-blur-xl border-b-2 border-navy-300 shadow-lg">
      <div class="px-4 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <a href="/admin" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-sage-500 to-sage-600 flex items-center justify-center shadow-md group-hover:shadow-lg transition-all group-hover:scale-105">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0v-6m3-3H9" />
              </svg>
            </div>
            <div>
              <span class="font-display font-bold text-lg text-navy-900">Nivaran</span>
              <p class="text-xs text-sage-700 font-bold">Admin Portal</p>
            </div>
          </a>

          <!-- Navigation -->
          <nav class="hidden lg:flex items-center gap-2">
            {adminNavItems.map((item) => (
              <a
                href={item.href}
                class={`flex items-center gap-2 px-4 py-2.5 rounded-lg font-bold text-sm transition-all ${
                  isActive(item.href)
                    ? 'bg-gradient-to-r from-sage-500 to-sage-600 text-white shadow-md'
                    : 'text-navy-700 hover:bg-sage-100 hover:text-sage-700'
                }`}
              >
                <span class="text-base">{item.icon}</span>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>

          <!-- User Menu -->
          <div class="flex items-center gap-3">
            <a href="/" class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-lg border-2 border-navy-300 text-navy-800 font-bold text-sm hover:bg-navy-50 transition-all">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
              <span>Public Site</span>
            </a>
            <button class="flex items-center gap-2 px-4 py-2 rounded-lg bg-navy-700 text-white font-bold text-sm hover:bg-navy-800 transition-all">
              <div class="w-7 h-7 rounded-lg bg-white/20 flex items-center justify-center text-xs">AD</div>
              <span class="hidden md:inline">Admin User</span>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <nav class="lg:hidden border-t-2 border-navy-200 py-2 flex gap-2 overflow-x-auto">
          {adminNavItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center gap-2 px-4 py-2 rounded-lg font-bold text-sm whitespace-nowrap transition-all ${
                isActive(item.href)
                  ? 'bg-gradient-to-r from-sage-500 to-sage-600 text-white shadow-md'
                  : 'text-navy-700 hover:bg-sage-100'
              }`}
            >
              <span>{item.icon}</span>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="pt-16 lg:pt-24 min-h-screen relative z-10">
      <div class="px-4 lg:px-8 py-6 lg:py-8">
        <!-- Breadcrumbs -->
        {breadcrumbs.length > 0 && (
          <nav class="flex items-center gap-2 mb-6">
            {breadcrumbs.map((crumb, i) => (
              <>
                {i > 0 && (
                  <svg class="w-4 h-4 text-navy-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                  </svg>
                )}
                {crumb.href ? (
                  <a href={crumb.href} class="text-navy-600 hover:text-sage-600 transition-colors font-bold text-sm">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="text-navy-900 font-bold text-base">{crumb.label}</span>
                )}
              </>
            ))}
          </nav>
        )}

        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="px-4 lg:px-8 py-6 border-t-2 border-navy-200 text-center text-sm text-navy-600 relative z-10 bg-white/50">
      <p class="font-semibold">Nivaran © 2026 — Government Pilot Marketplace</p>
    </footer>
  </body>
</html>
