---
import TopNav from '../components/TopNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  pageTitle?: string;
  showNav?: boolean;
  transparentNav?: boolean;
}

const { title = 'GovPilot', pageTitle, showNav = true, transparentNav = false } = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="GovPilot — Government Innovation Management Platform" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <title>{pageTitle ? `${pageTitle} — ${title}` : title}</title>

    <script is:inline>
      document.documentElement.classList.remove('dark');
    </script>
  </head>
  <body class="bg-gray-50 min-h-screen">
    {showNav && <TopNav currentPath={currentPath} transparent={transparentNav} />}

    <slot />

    <footer class="bg-navy-900 text-white py-12">
      <div class="max-w-7xl mx-auto px-4 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-10 h-10 rounded-lg bg-sage-500 flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0v-6m3-3H9" />
                </svg>
              </div>
              <span class="font-display font-bold text-2xl">GovPilot</span>
            </div>
            <p class="text-sage-200 text-sm mb-4">Connecting government challenges with innovative startup solutions for a better tomorrow.</p>
            <div class="flex gap-3">
              <a href="#" class="w-9 h-9 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                <span class="text-sm">𝕏</span>
              </a>
              <a href="#" class="w-9 h-9 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                <span class="text-sm">in</span>
              </a>
              <a href="#" class="w-9 h-9 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                <span class="text-sm">📧</span>
              </a>
            </div>
          </div>
          <div>
            <h4 class="font-bold text-sm uppercase tracking-wider mb-4">For Government</h4>
            <ul class="space-y-2 text-sm text-sage-200">
              <li><a href="/admin" class="hover:text-white transition-colors">Admin Dashboard</a></li>
              <li><a href="/admin/problems" class="hover:text-white transition-colors">Submit Problems</a></li>
              <li><a href="/admin/pilots" class="hover:text-white transition-colors">Active Pilots</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-sm uppercase tracking-wider mb-4">For Startups</h4>
            <ul class="space-y-2 text-sm text-sage-200">
              <li><a href="/startup" class="hover:text-white transition-colors">Startup Portal</a></li>
              <li><a href="/startup/opportunities" class="hover:text-white transition-colors">Opportunities</a></li>
              <li><a href="/startup/apply" class="hover:text-white transition-colors">Apply Now</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-white/10 mt-8 pt-8 text-center text-sm text-sage-300">
          © 2026 GovPilot. All rights reserved. | <a href="#" class="hover:text-white">Privacy Policy</a> | <a href="#" class="hover:text-white">Terms of Service</a>
        </div>
      </div>
    </footer>
  </body>
</html>
